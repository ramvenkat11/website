// Advertising Budget Allocator - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "split", "args": { "budget": 50000.0, "searchShare": 0.5 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate a mock advertising budget split...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "split": {
      "args": { "budget": { "type": "float" }, "searchShare": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(budget * searchShare, 2) }"
      }
    }
  }
}
