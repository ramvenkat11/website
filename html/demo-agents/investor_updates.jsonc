// Investor Update Drafter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "investorUpdate": "{ conv.investorUpdate if sys.exists('conv', 'investorUpdate') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "investorUpdate": "{ facts['investorUpdate'] if 'investorUpdate' in facts and facts['investorUpdate'] else investorUpdate }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ investorUpdate == '' }",
          "then": {
            "ask": {
              "message": "Which update?",
              "inputs": [ { "name": "investorUpdate", "type": "str", "description": "For example Monthly, Quarterly or Annual letter." } ]
            },
            "var": { "investorUpdate": "{ result['investorUpdate'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.investorUpdate": "{ investorUpdate }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the investor update the user wants.",
      "args": {
        "investorUpdate": { "type": "str", "required": false, "description": "The investor update the user wants, for example Monthly, Quarterly or Annual letter. Empty if unknown." }
      }
    }
  }
}
