// Investor Update Drafter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it says which update the user wants.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "period": {
                "type": "choice",
                "instructions": "Whether the message says which investor update the user wants",
                "criteria": {
                  "stated": "The message says which investor update the user wants, for example monthly, quarterly or the annual letter",
                  "not stated": "The message does not say which investor update"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "periodStated": "{ jev['period']['choice'] if 'period' in jev and 'choice' in jev['period'] else 'not stated' }",
          "period": ""
        },

        // Ask the user only when the message does not say which update.
        "if.2": {
          "condition": "{ periodStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which update?",
              "inputs": [ { "name": "period", "type": "str", "description": "For example Monthly, Quarterly or Annual letter." } ]
            },
            "var": { "period": "{ result['period'] }" }
          }
        },

        // The LLM reads the update from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the investor update drafter at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (update: {period})' if period else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
