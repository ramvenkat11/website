// Key Message Consistency Checker - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "facts": { "draft": "{ sys.query }" },
          "tone": { "draft": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "factsView": "{ result['facts'] }", "toneView": "{ result['tone'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to combine the 2 results into one answer...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "facts": {
      "args": { "draft": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to point out any statement in the draft that contradicts made-up key messages...",
        "llm": { "profile": "gpt5_mini", "prompt": "facts" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "tone": {
      "args": { "draft": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to say whether the draft sounds like Northwind: plain, confident and never dismissive...",
        "llm": { "profile": "gpt5_mini", "prompt": "tone" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
