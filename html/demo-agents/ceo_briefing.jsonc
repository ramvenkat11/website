// CEO Briefing Builder - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "headlines": { "question": "{ sys.query }" },
          "risks": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "output": "{ '## Headlines\\n' + result['headlines'] + '\\n\\n## Risks and decisions\\n' + result['risks'] }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "headlines": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "prompt": {
          "name": "headlines",
          "system": "You are the CEO briefing builder at Northwind Corp. Use made-up data. List the key business headlines for this week. Keep the answer short.",
          "user": "{ question }"
        },
        "llm": { "profile": "gpt5_mini", "prompt": "headlines" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "risks": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "prompt": {
          "name": "risks",
          "system": "You are the CEO briefing builder at Northwind Corp. Use made-up data. List the risks and decisions that need the CEO's attention. Keep the answer short.",
          "user": "{ question }"
        },
        "llm": { "profile": "gpt5_mini", "prompt": "risks" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
