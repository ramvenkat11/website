// Inbound Shipment Tracker - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "warehouse": "{ conv.warehouse if sys.exists('conv', 'warehouse') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "warehouse": "{ facts['warehouse'] if 'warehouse' in facts and facts['warehouse'] else warehouse }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ warehouse == '' }",
          "then": {
            "ask": {
              "message": "Which warehouse?",
              "inputs": [
                { "name": "warehouse", "type": "str", "description": "For example All, Chicago, Dallas or Newark." }
              ]
            },
            "var": { "warehouse": "{ result['warehouse'] }" }
          }
        },
        "var.5": { "warehouseScope": "{ 'all' if warehouse.strip().lower() == 'all' else ('one warehouse' if warehouse else 'not stated') }" },

        // Branch on a condition.
        "if.3": {
          "condition": "{ warehouseScope == 'all' }",
          "then": { "var": { "focus": " Focus on every warehouse." } },
          "else": { "var": { "focus": "{ f' Focus on {warehouse.lower()}.' if warehouse else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.warehouse": "{ warehouse }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the warehouse the user is asking about.",
      "args": {
        "warehouse": { "type": "str", "required": false, "description": "The warehouse the user asks about, for example Dallas or Chicago, or all when the user asks about every warehouse. Empty if unknown." }
      }
    }
  }
}
