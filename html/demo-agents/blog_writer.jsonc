// Blog Article Drafter - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "outline": { "question": "{ sys.query }" },
          "headlines": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "outlineView": "{ result['outline'] }", "headlinesView": "{ result['headlines'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to combine the 2 results into one answer...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "outline": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Anthropic claude-haiku-4-5 to write a short outline (mock data)...",
        "llm": { "profile": "claude_haiku", "prompt": "outline" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "headlines": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Anthropic claude-haiku-4-5 to suggest three headlines (mock data)...",
        "llm": { "profile": "claude_haiku", "prompt": "headlines" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
