// Defect Metrics Reporter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "escape_rate", "args": { "found_in_test": 184, "found_in_production": 23 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "escape_rate": {
      "args": { "found_in_test": { "type": "int" }, "found_in_production": { "type": "int" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(found_in_production / (found_in_test + found_in_production) * 100, 1) }"
      }
    }
  }
}
