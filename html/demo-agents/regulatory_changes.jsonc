// Regulatory Change Tracker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "regulationArea": "{ conv.regulationArea if sys.exists('conv', 'regulationArea') and conv.regulationArea.strip().lower() not in ['all', 'any', 'anything'] else '' }"
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock data as an agent that summarizes new and upcoming laws and regulations that affect the company, when they take effect, and which teams must change what...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
