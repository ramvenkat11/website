// Request for Proposal Drafter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "requirements": { "question": "{ sys.query }" },
          "scoring": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "requirementsView": "{ result['requirements'] }", "scoringView": "{ result['scoring'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to combine the 2 results into one answer...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "requirements": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to write the scope and the requirements suppliers must answer (mock data)...",
        "llm": { "profile": "gpt5_mini", "prompt": "requirements" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "scoring": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to list the evaluation criteria with a weight for each (mock data)...",
        "llm": { "profile": "gpt5_mini", "prompt": "scoring" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
