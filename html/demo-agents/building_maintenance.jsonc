// Building Maintenance Request - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "buildingProblem": "{ conv.buildingProblem if sys.exists('conv', 'buildingProblem') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "buildingProblem": "{ facts['buildingProblem'] if 'buildingProblem' in facts and facts['buildingProblem'] else buildingProblem }"
        },
        "var.5": { "buildingProblemScope": "{ 'not stated' if buildingProblem == '' else ('other' if buildingProblem.strip().lower() == 'other' else 'one kind') }" },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ buildingProblem == '' }",
          "then": {
            "ask": {
              "message": "What is the problem?",
              "inputs": [
              { "name": "buildingProblem", "type": "str", "description": "For example Other, Heating, Lighting, Plumbing or Door." }
            ]
            },
            "var": {
              "buildingProblem": "{ result['buildingProblem'] }",
              "buildingProblemScope": "{ 'other' if result['buildingProblem'].strip().lower() == 'other' else 'one kind' }"
            }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ buildingProblemScope == 'other' }",
          "then": { "var": { "focus": " Focus on the problem described." } },
          "else": { "var": { "focus": "{ f' Focus on {buildingProblem.lower()}.' if buildingProblem else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.buildingProblem": "{ buildingProblem }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the kind of building problem the user reports.",
      "args": {
        "buildingProblem": { "type": "str", "required": false, "description": "The kind of building problem the user reports, for example heating, lighting, plumbing or door, or 'other' when the user says it is some other kind without naming it. Empty if unknown." }
      }
    }
  }
}
