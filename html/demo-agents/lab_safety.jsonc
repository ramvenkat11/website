// Lab Safety Checker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "labWork": "{ conv.labWork if sys.exists('conv', 'labWork') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "labWork": "{ facts['labWork'] if 'labWork' in facts and facts['labWork'] else labWork }",
          "unknownSubstance": "{ facts['unknownSubstance'] if 'unknownSubstance' in facts and facts['unknownSubstance'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ labWork == '' }",
          "then": {
            "ask": {
              "message": "What kind of work are you planning?",
              "inputs": [ { "name": "labWork", "type": "str", "description": "For example Chemicals, Lasers, High voltage or Biological samples." } ]
            },
            "var": { "labWork": "{ result['labWork'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "unknownSubstance": "{ facts['unknownSubstance'] if 'unknownSubstance' in facts and facts['unknownSubstance'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.labWork": "{ labWork }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ unknownSubstance == True }",
          "then": { "end": "Do not handle an unknown substance. Seal it and call the lab safety officer on extension 4400." }
        },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the lab work the user is planning.",
      "args": {
        "labWork": { "type": "str", "required": false, "description": "The kind of lab work the user is planning, for example lasers or radioactive sources. Empty if unknown." },
        "unknownSubstance": { "type": "bool | null", "required": false, "description": "True if the user says the work involves a substance they cannot identify, False if the work is described and involves none, null when neither the message nor the known facts say." }
      }
    }
  }
}
