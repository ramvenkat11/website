// Regression Suite Planner - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the product area.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "area": {
                "type": "choice",
                "instructions": "Whether the message names the product area the user tests",
                "criteria": {
                  "stated": "The message names the product area the user tests, for example checkout or search",
                  "not stated": "The message does not name a product area"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "areaStated": "{ jev['area']['choice'] if 'area' in jev and 'choice' in jev['area'] else 'not stated' }",
          "area": ""
        },

        // Ask the user only when the message does not name the product area.
        "if.2": {
          "condition": "{ areaStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which product area do you test?",
              "inputs": [ { "name": "area", "type": "str", "description": "For example Checkout, Accounts, Search or Mobile app." } ]
            },
            "var": { "area": "{ result['area'] }" }
          }
        },

        // The LLM reads the product area from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the regression suite planner at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user tests the area: {area}.' if area else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
