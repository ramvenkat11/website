// Deployment Status Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "services": ["api", "web", "worker", "billing"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ services }",
          "loopVar": "service",
          "do": {
            "var": { "lines": "{ lines + '- ' + service + '\\n' }" }
          }
        },

        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
