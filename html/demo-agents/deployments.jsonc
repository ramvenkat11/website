// Deployment Status Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "deployEnvironment": "{ conv.deployEnvironment if sys.exists('conv', 'deployEnvironment') else '' }"
        },

        // The list to work through.
        "var.2": { "services": ["api", "web", "worker", "billing"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ services }",
          "loopVar": "service",
          "do": {
            "var": { "lines": "{ lines + '- ' + service + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate mock deployment records...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
