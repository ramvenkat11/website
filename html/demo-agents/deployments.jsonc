// Deployment Status Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "services": ["api", "web", "worker", "billing"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ services }",
          "loopVar": "service",
          "do": {
            "var": { "lines": "{ lines + '- ' + service + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the deployment status checker at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
