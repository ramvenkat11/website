// Metric Definition Lookup - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the business area of the metric.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "area": {
                "type": "choice",
                "instructions": "Whether the message names the business area the metric belongs to",
                "criteria": {
                  "stated": "The message names the business area the metric belongs to, for example revenue or product usage",
                  "not stated": "The message does not name a business area"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "areaStated": "{ jev['area']['choice'] if 'area' in jev and 'choice' in jev['area'] else 'not stated' }",
          "area": ""
        },

        // Ask the user only when the message does not name the area.
        "if.2": {
          "condition": "{ areaStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which area is the metric from?",
              "inputs": [ { "name": "area", "type": "str", "description": "For example Revenue, Customers, Product usage or Operations." } ]
            },
            "var": { "area": "{ result['area'] }" }
          }
        },

        // The LLM reads the metric area from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the metric definition lookup at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (metric area: {area})' if area else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
