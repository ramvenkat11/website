// Metric Definition Lookup - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "businessArea": "{ conv.businessArea if sys.exists('conv', 'businessArea') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "businessArea": "{ facts['businessArea'] if 'businessArea' in facts and facts['businessArea'] else businessArea }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ businessArea == '' }",
          "then": {
            "ask": {
              "message": "Which area is the metric from?",
              "inputs": [ { "name": "businessArea", "type": "str", "description": "For example Revenue, Customers, Product usage or Operations." } ]
            },
            "var": { "businessArea": "{ result['businessArea'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.businessArea": "{ businessArea }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the business area of the metric the user asks about.",
      "args": {
        "businessArea": { "type": "str", "required": false, "description": "The business area the metric belongs to, for example revenue or product usage. Empty if unknown." }
      }
    }
  }
}
