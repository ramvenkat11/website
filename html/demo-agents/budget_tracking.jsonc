// Budget vs Actual Reporter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "team": "{ conv.team if sys.exists('conv', 'team') else '' }"
        },

        // Call a function with arguments.
        "func": { "name": "variance", "args": { "budget": 120000.0, "actual": 131500.0 } },

        // Use the value the function returned.
        "var.2": { "figure": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to generate mock budget and spending figures...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "variance": {
      "args": { "budget": { "type": "float" }, "actual": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round((actual - budget) / budget * 100, 1) }"
      }
    }
  }
}
