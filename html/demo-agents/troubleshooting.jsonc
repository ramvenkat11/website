// Product Troubleshooting Guide - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "checks": ["Restart it", "Check the cable", "Update the software", "Reset to factory settings"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ checks }",
          "loopVar": "check",
          "do": {
            "var": { "lines": "{ lines + '- ' + check + '\\n' }" }
          }
        },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
