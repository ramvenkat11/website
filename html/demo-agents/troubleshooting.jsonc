// Product Troubleshooting Guide - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "checks": ["Restart it", "Check the cable", "Update the software", "Reset to factory settings"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ checks }",
          "loopVar": "check",
          "do": {
            "var": { "lines": "{ lines + '- ' + check + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the product troubleshooting guide at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
