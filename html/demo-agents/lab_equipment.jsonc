// Lab Equipment Booker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "labInstrument": "{ conv.labInstrument if sys.exists('conv', 'labInstrument') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "labInstrument": "{ facts['labInstrument'] if 'labInstrument' in facts and facts['labInstrument'] else labInstrument }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ labInstrument == '' }",
          "then": {
            "ask": {
              "message": "Which instrument do you need?",
              "inputs": [ { "name": "labInstrument", "type": "str", "description": "For example Mass spectrometer, Electron microscope or 3D printer." } ]
            },
            "var": { "labInstrument": "{ result['labInstrument'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.labInstrument": "{ labInstrument }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the instrument the user needs.",
      "args": {
        "labInstrument": { "type": "str", "required": false, "description": "The instrument the user needs, for example an electron microscope or a 3D printer. Empty if unknown." }
      }
    }
  }
}
