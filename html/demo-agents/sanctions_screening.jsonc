// Sanctions Screening Checker - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "screenedParty": "{ conv.screenedParty if sys.exists('conv', 'screenedParty') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "screenedParty": "{ facts['screenedParty'] if 'screenedParty' in facts and facts['screenedParty'] else screenedParty }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ screenedParty == '' }",
          "then": {
            "ask": {
              "message": "Who should be screened?",
              "inputs": [ { "name": "screenedParty", "type": "str", "label": "Name", "description": "A person or company name" } ]
            },
            "var": { "screenedParty": "{ result['screenedParty'].strip() }" },

            // Stop with an error the user sees.
            "if": {
              "condition": "{ len(screenedParty) < 2 }",
              "then": { "fail": "Enter a person or company name to screen." }
            }
          }
        },

        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'sanctions screening requested for a name of length ' + str(len(screenedParty)) }" },

        // Shared with every agent in the conversation.
        "var.4": { "conv.screenedParty": "{ screenedParty }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the person or company the user wants screened.",
      "args": {
        "screenedParty": { "type": "str", "required": false, "description": "The name of the person or company to screen. Empty if unknown." }
      }
    }
  }
}
