// Packaging Spec Advisor - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "packedItem": "{ conv.packedItem if sys.exists('conv', 'packedItem') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "packedItem": "{ facts['packedItem'] if 'packedItem' in facts and facts['packedItem'] else packedItem }",
          "isHazardous": "{ facts['isHazardous'] if 'isHazardous' in facts and facts['isHazardous'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ packedItem == '' }",
          "then": {
            "ask": {
              "message": "What kind of item are you packing?",
              "inputs": [ { "name": "packedItem", "type": "str", "description": "For example Fragile, Heavy, Temperature sensitive or Hazardous." } ]
            },
            "var": { "packedItem": "{ result['packedItem'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "isHazardous": "{ facts['isHazardous'] if 'isHazardous' in facts and facts['isHazardous'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.packedItem": "{ packedItem }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ isHazardous == True }",
          "then": { "end": "Hazardous items follow separate rules. Ask the hazardous materials agent instead." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the item the user is packing.",
      "args": {
        "packedItem": { "type": "str", "required": false, "description": "The kind of item being packed, for example fragile glassware or frozen food. Empty if unknown." },
        "isHazardous": { "type": "bool | null", "required": false, "description": "True if the item being packed is hazardous, false if it is not, null when neither the message nor the known facts say." }
      }
    }
  }
}
