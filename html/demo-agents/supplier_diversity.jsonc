// Diverse Supplier Finder - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "certifications": ["Small business", "Minority-owned", "Women-owned", "Veteran-owned"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ certifications }",
          "loopVar": "certification",
          "do": {
            "var": { "lines": "{ lines + '- ' + certification + '\\n' }" }
          }
        },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
