// Password Reset Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "account": "{ conv.account if sys.exists('conv', 'account') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "account": "{ facts['account'] if 'account' in facts and facts['account'] else account }",
          "forSomeoneElse": "{ facts['forSomeoneElse'] if 'forSomeoneElse' in facts and facts['forSomeoneElse'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ account == '' }",
          "then": {
            "ask": {
              "message": "Which account?",
              "inputs": [ { "name": "account", "type": "str", "description": "For example Email, Laptop or VPN." } ]
            },
            "var": { "account": "{ result['account'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "forSomeoneElse": "{ facts['forSomeoneElse'] if 'forSomeoneElse' in facts and facts['forSomeoneElse'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.account": "{ account }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ forSomeoneElse == True }",
          "then": { "end": "Only the account owner can reset a password." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the account whose password needs resetting.",
      "args": {
        "account": { "type": "str", "required": false, "description": "The account whose password needs resetting, for example email, VPN or Slack. Empty if unknown." },
        "forSomeoneElse": { "type": "bool | null", "required": false, "description": "True if the account belongs to someone other than the user, false if it is the user's own, null when neither the message nor the known facts say." }
      }
    }
  }
}
