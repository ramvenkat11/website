// Password Reset Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Ask the user for what the agent needs.
        "ask": {
          "message": "Which account?",
          "inputs": [ { "name": "account", "type": "chooseOne", "options": ["Email", "Laptop", "VPN", "Another person"] } ]
        },

        "var": { "account": "{ result['account'] }" },

        // Finish early with a message; no LLM call needed.
        "if": {
          "condition": "{ account == 'Another person' }",
          "then": { "end": "Only the account owner can reset a password." }
        },

        "prompt": {
          "system": "You are the password reset helper at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (account: {account})' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
