// Password Reset Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the account, and whether that belongs to someone else.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "account": {
                "type": "choice",
                "instructions": "Whether the message names the account whose password needs resetting",
                "criteria": {
                  "stated": "The message names the account whose password needs resetting, for example email, VPN or Slack",
                  "not stated": "The message does not name an account"
                }
              },
              "forSomeoneElse": {
                "type": "choice",
                "instructions": "Whether the account belongs to someone other than the user",
                "criteria": {
                  "Yes": "The message says the account belongs to someone other than the user",
                  "No": "The message says the account is the user's own",
                  "cannot tell": "The message does not clearly say whose account it is"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "accountStated": "{ jev['account']['choice'] if 'account' in jev and 'choice' in jev['account'] else 'not stated' }",
          "forSomeoneElse": "{ jev['forSomeoneElse']['choice'] if 'forSomeoneElse' in jev and 'choice' in jev['forSomeoneElse'] else 'cannot tell' }",
          "account": ""
        },

        // Ask the user only when the message does not name the account.
        "if.2": {
          "condition": "{ accountStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which account?",
              "inputs": [ { "name": "account", "type": "str", "description": "For example Email, Laptop or VPN." } ]
            },
            "var": { "account": "{ result['account'] }" }
          }
        },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ forSomeoneElse == 'Yes' }",
          "then": { "end": "Only the account owner can reset a password." }
        },

        // The LLM reads the account from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the password reset helper at Northwind Corp. Use made-up data. Only the account owner can reset a password; if the account belongs to someone else, say so and do not reset it. Keep the answer short.",
          "user": "{ f'{sys.query} (account: {account})' if account else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
