// Shareholder Dividend Questions - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Kept for this agent across the conversation.
        "var": { "agent.visits": "{ agent.visits + 1 if sys.exists('agent', 'visits') else 1 }" },

        // Shared by every agent in the conversation.
        "var.2": { "conv.lastTopic": "dividends" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock dividend details...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
