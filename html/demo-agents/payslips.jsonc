// Payslip Question Answerer - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "net_pay", "args": { "gross": 5200.0, "taxRate": 0.28 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to generate a mock payslip...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "net_pay": {
      "args": { "gross": { "type": "float" }, "taxRate": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(gross * (1 - taxRate), 2) }"
      }
    }
  }
}
