// Campaign Performance Reporter - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "leads": "{ randint(200, 1500) }" },

        // Tell the user what is happening while they wait.
        "progress": "{ f'Found {leads} leads from the campaign...' }",

        "prompt": {
          "system": "You are the campaign performance reporter at Northwind Corp. Use made-up data. Keep the answer short. Answer in plain text, not JSON or code.",
          "user": "{ f'{sys.query} There are {leads} leads from the campaign.' }"
        },
        "llm": { "profile": "ollama_nemotron", "streamOutput": true }
      }
    }
  }
}
