// Campaign Performance Reporter - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "leads": "{ randint(200, 1500) }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Ollama gemma4:31b to generate mock campaign results...",
        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
