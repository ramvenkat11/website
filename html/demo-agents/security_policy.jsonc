// Information Security Policy Guide - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp", "policyVersion": "4.2" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate a mock security policy answer...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
