// Information Security Policy Guide - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp", "policyVersion": "4.2" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock data as an agent that answers questions about the company's information security policies, such as acceptable use, clean desk, travel with laptops and bringing your own device, quoting the policy section that applies...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
