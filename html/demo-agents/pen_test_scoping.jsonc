// Penetration Test Scoper - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with an argument.
        "func": { "name": "test_window", "args": { "days": 5 } },

        // Use the value the function returned.
        "var": { "window": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate a mock penetration test scope...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Build a value and return it.
    "test_window": {
      "args": { "days": { "type": "int" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ str(days) + ' working days, outside business hours' }"
      }
    }
  }
}
