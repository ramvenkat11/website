// Security Awareness Training Tracker - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "courses": ["Phishing basics", "Safe passwords", "Handling customer data", "Working remotely"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ courses }",
          "loopVar": "course",
          "do": {
            "var": { "lines": "{ lines + '- ' + course + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to generate mock security training records...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
