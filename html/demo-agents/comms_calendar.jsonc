// Communications Calendar Planner - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "weeks": [1, 2, 3, 4], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ weeks }",
          "loopVar": "week",
          "do": {
            "var": { "lines": "{ lines + '- Week ' + str(week) + '\\n' }" }
          }
        },

        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
