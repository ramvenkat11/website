// Month-End Close Tracker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "done": { "question": "{ sys.query }" },
          "open": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "doneView": "{ result['done'] }", "openView": "{ result['open'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to combine the 2 results into one answer...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "done": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Google gemini-3.6-flash to list the close tasks already completed (mock data)...",
        "llm": { "profile": "gemini_flash", "prompt": "done" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "open": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Google gemini-3.6-flash to list the close tasks still open and who owns them (mock data)...",
        "llm": { "profile": "gemini_flash", "prompt": "open" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
