// Pricing Experiment Planner - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it says who would see the test, and whether that is existing customers at renewal.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "audience": {
                "type": "choice",
                "instructions": "Whether the message says which customers would see the price test",
                "criteria": {
                  "stated": "The message says which customers would see the price test, for example trial users or enterprise accounts",
                  "not stated": "The message does not say which customers would see the test"
                }
              },
              "atRenewal": {
                "type": "choice",
                "instructions": "Whether the price test would show to existing customers at renewal",
                "criteria": {
                  "Yes": "The test would show to existing customers at renewal",
                  "No": "The test would show to other customers, not to existing customers at renewal",
                  "cannot tell": "The message does not say enough to tell"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "audienceStated": "{ jev['audience']['choice'] if 'audience' in jev and 'choice' in jev['audience'] else 'not stated' }",
          "atRenewal": "{ jev['atRenewal']['choice'] if 'atRenewal' in jev and 'choice' in jev['atRenewal'] else 'cannot tell' }",
          "audience": ""
        },

        // Ask the user only when the message does not say who would see the test.
        "if.2": {
          "condition": "{ audienceStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which customers would see the test?",
              "inputs": [ { "name": "audience", "type": "str", "description": "For example New sign-ups, Trial users or Existing customers at renewal." } ]
            },
            "var": { "audience": "{ result['audience'] }" }
          }
        },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ atRenewal == 'Yes' }",
          "then": { "fail": "Price tests on existing customers at renewal need approval from the pricing committee first." }
        },

        // The LLM reads the test audience from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the pricing experiment planner at Northwind Corp. Use made-up data. Price tests on existing customers at renewal need approval from the pricing committee first; if the test audience is existing customers at renewal, say so instead of planning it. Keep the answer short.",
          "user": "{ f'{sys.query} (test audience: {audience})' if audience else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
