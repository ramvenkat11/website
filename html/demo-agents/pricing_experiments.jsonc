// Pricing Experiment Planner - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "priceTestAudience": "{ conv.priceTestAudience if sys.exists('conv', 'priceTestAudience') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "priceTestAudience": "{ facts['priceTestAudience'] if 'priceTestAudience' in facts and facts['priceTestAudience'] else priceTestAudience }",
          "atRenewal": "{ facts['atRenewal'] if 'atRenewal' in facts and facts['atRenewal'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ priceTestAudience == '' }",
          "then": {
            "ask": {
              "message": "Which customers would see the test?",
              "inputs": [ { "name": "priceTestAudience", "type": "str", "description": "For example New sign-ups, Trial users or Existing customers at renewal." } ]
            },
            "var": { "priceTestAudience": "{ result['priceTestAudience'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "atRenewal": "{ facts['atRenewal'] if 'atRenewal' in facts and facts['atRenewal'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.priceTestAudience": "{ priceTestAudience }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ atRenewal == True }",
          "then": { "fail": "Price tests on existing customers at renewal need approval from the pricing committee first." }
        },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records which customers would see the price test.",
      "args": {
        "priceTestAudience": { "type": "str", "required": false, "description": "Which customers would see the price test, for example trial users or enterprise accounts. Empty if unknown." },
        "atRenewal": { "type": "bool | null", "required": false, "description": "True if the test would show to existing customers at renewal, false if it would show to other customers, null when neither the message nor the known facts say." }
      }
    }
  }
}
