// Sales Pipeline Reporter - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "stages": ["Prospecting", "Qualified", "Proposal", "Negotiation", "Closed won"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ stages }",
          "loopVar": "stage",
          "do": {
            "var": { "lines": "{ lines + '- ' + stage + '\\n' }" }
          }
        },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
