// Sales Pipeline Reporter - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "stages": ["Prospecting", "Qualified", "Proposal", "Negotiation", "Closed won"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ stages }",
          "loopVar": "stage",
          "do": {
            "var": { "lines": "{ lines + '- ' + stage + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the sales pipeline reporter at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
