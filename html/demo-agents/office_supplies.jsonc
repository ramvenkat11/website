// Office Supply Orderer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "items": ["Paper", "Pens", "Notebooks", "Printer toner"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ items }",
          "loopVar": "item",
          "do": {
            "var": { "lines": "{ lines + '- ' + item + '\\n' }" }
          }
        },

        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
