// Office Supply Orderer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "items": ["Paper", "Pens", "Notebooks", "Printer toner"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ items }",
          "loopVar": "item",
          "do": {
            "var": { "lines": "{ lines + '- ' + item + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the office supply orderer at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
