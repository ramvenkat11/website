// Laptop and Monitor Request Handler - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "hardwareItem": "{ conv.hardwareItem if sys.exists('conv', 'hardwareItem') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "hardwareItem": "{ facts['hardwareItem'] if 'hardwareItem' in facts and facts['hardwareItem'] else hardwareItem }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ hardwareItem == '' }",
          "then": {
            "ask": {
              "message": "What do you need?",
              "inputs": [
                { "name": "hardwareItem", "type": "str", "description": "For example Anything, Laptop, Monitor, Keyboard or Headset." }
              ]
            },
            "var": { "hardwareItem": "{ result['hardwareItem'] }" }
          }
        },
        "var.5": { "itemScope": "{ 'anything' if hardwareItem.strip().lower() == 'anything' else ('one item' if hardwareItem else 'not stated') }" },

        // Branch on a condition.
        "if.3": {
          "condition": "{ itemScope == 'anything' }",
          "then": { "var": { "focus": " Focus on any equipment." } },
          "else": { "var": { "focus": "{ f' Focus on {hardwareItem.lower()}.' if hardwareItem else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.hardwareItem": "{ hardwareItem }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the equipment the user needs.",
      "args": {
        "hardwareItem": { "type": "str", "required": false, "description": "The equipment the user needs, for example a laptop or a docking station, or anything when the user says any equipment will do. Empty if unknown." }
      }
    }
  }
}
