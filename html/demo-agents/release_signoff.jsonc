// Release Sign-off Checklist - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "gates": ["All P1 bugs closed", "Regression suite passed", "Performance within budget", "Security scan clean", "Rollback plan approved"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ gates }",
          "loopVar": "gate",
          "do": {
            "var": { "lines": "{ lines + '- ' + gate + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Ollama gemma4:31b to generate a mock release readiness check...",
        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
