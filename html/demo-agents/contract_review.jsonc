// Contract Clause Reviewer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "clauses": ["Liability", "Indemnity", "Termination", "Auto-renewal", "Payment terms"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ clauses }",
          "loopVar": "clause",
          "do": {
            "var": { "lines": "{ lines + '- ' + clause + '\\n' }" }
          }
        },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
