// Contract Clause Reviewer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "clauses": ["Liability", "Indemnity", "Termination", "Auto-renewal", "Payment terms"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ clauses }",
          "loopVar": "clause",
          "do": {
            "var": { "lines": "{ lines + '- ' + clause + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the contract clause reviewer at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
