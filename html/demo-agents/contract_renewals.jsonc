// Supplier Contract Renewal Tracker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the spending category.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "category": {
                "type": "choice",
                "instructions": "Whether the message names the spending category of the supplier contracts the user asks about",
                "criteria": {
                  "stated": "The message names the spending category of the supplier contracts, for example software or logistics",
                  "not stated": "The message does not name a spending category"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "categoryStated": "{ jev['category']['choice'] if 'category' in jev and 'choice' in jev['category'] else 'not stated' }",
          "category": ""
        },

        // Ask the user only when the message does not name the spending category.
        "if.2": {
          "condition": "{ categoryStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which spending category do you manage?",
              "inputs": [ { "name": "category", "type": "str", "description": "For example Software, Logistics, Facilities services or Raw materials." } ]
            },
            "var": { "category": "{ result['category'] }" }
          }
        },

        // The LLM reads the category from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the supplier contract renewal tracker at Northwind Corp. Use made-up contracts, end dates, notice periods and values. Keep the answer short.",
          "user": "{ f'{sys.query} The user manages the category: {category}.' if category else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
