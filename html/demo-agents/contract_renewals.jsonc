// Supplier Contract Renewal Tracker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "spendCategory": "{ conv.spendCategory if sys.exists('conv', 'spendCategory') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "spendCategory": "{ facts['spendCategory'] if 'spendCategory' in facts and facts['spendCategory'] else spendCategory }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ spendCategory == '' }",
          "then": {
            "ask": {
              "message": "Which spending category do you manage?",
              "inputs": [ { "name": "spendCategory", "type": "str", "description": "For example Software, Logistics, Facilities services or Raw materials." } ]
            },
            "var": { "spendCategory": "{ result['spendCategory'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.spendCategory": "{ spendCategory }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the spending category of the supplier contracts the user asks about.",
      "args": {
        "spendCategory": { "type": "str", "required": false, "description": "The spending category of the supplier contracts the user asks about, for example software or logistics. Empty if unknown." }
      }
    }
  }
}
