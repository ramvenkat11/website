// Sales Commission Calculator - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "commission", "args": { "closed": 240000.0, "rate": 0.08 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock data as an agent that calculates a salesperson's commission for a quarter from their closed deals, quota attainment and commission plan, and explains each line of the payout...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "commission": {
      "args": { "closed": { "type": "float" }, "rate": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(closed * rate, 2) }"
      }
    }
  }
}
