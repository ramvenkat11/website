// Beta Program Enrollment - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "customerPlan": "{ conv.customerPlan if sys.exists('conv', 'customerPlan') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "customerPlan": "{ facts['customerPlan'] if 'customerPlan' in facts and facts['customerPlan'] else customerPlan }",
          "freeTrial": "{ facts['freeTrial'] if 'freeTrial' in facts and facts['freeTrial'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ customerPlan == '' }",
          "then": {
            "ask": {
              "message": "Which plan is the customer on?",
              "inputs": [ { "name": "customerPlan", "type": "str", "description": "For example Enterprise, Business, Starter or Free trial." } ]
            },
            "var": { "customerPlan": "{ result['customerPlan'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "freeTrial": "{ facts['freeTrial'] if 'freeTrial' in facts and facts['freeTrial'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.customerPlan": "{ customerPlan }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ freeTrial == True }",
          "then": { "end": "Free trial accounts cannot join beta programs. Ask again once the account is on a paid plan." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the plan the customer is on.",
      "args": {
        "customerPlan": { "type": "str", "required": false, "description": "The plan the customer is on, for example Enterprise or Starter. Empty if unknown." },
        "freeTrial": { "type": "bool | null", "required": false, "description": "True if the customer is on a free trial, False if on another plan, null when neither the message nor the known facts say." }
      }
    }
  }
}
