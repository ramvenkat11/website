// Beta Program Enrollment - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the plan, and whether that is a free trial.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "plan": {
                "type": "choice",
                "instructions": "Whether the message names the plan the customer is on",
                "criteria": {
                  "stated": "The message names the plan the customer is on, for example Enterprise or Starter",
                  "not stated": "The message does not name the plan"
                }
              },
              "freeTrial": {
                "type": "choice",
                "instructions": "Whether the customer is on a free trial",
                "criteria": {
                  "Yes": "The customer is on a free trial",
                  "No": "The customer is on a plan other than a free trial",
                  "cannot tell": "The message does not say enough to tell"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "planStated": "{ jev['plan']['choice'] if 'plan' in jev and 'choice' in jev['plan'] else 'not stated' }",
          "freeTrial": "{ jev['freeTrial']['choice'] if 'freeTrial' in jev and 'choice' in jev['freeTrial'] else 'cannot tell' }",
          "plan": ""
        },

        // Ask the user only when the message does not name the plan.
        "if.2": {
          "condition": "{ planStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which plan is the customer on?",
              "inputs": [ { "name": "plan", "type": "str", "description": "For example Enterprise, Business, Starter or Free trial." } ]
            },
            "var": { "plan": "{ result['plan'] }" }
          }
        },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ freeTrial == 'Yes' }",
          "then": { "end": "Free trial accounts cannot join beta programs. Ask again once the account is on a paid plan." }
        },

        // The LLM reads the plan from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the beta program enrollment assistant at Northwind Corp. Use made-up data. Free trial accounts cannot join beta programs until they move to a paid plan. Keep the answer short.",
          "user": "{ f'{sys.query} (customer plan: {plan})' if plan else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
