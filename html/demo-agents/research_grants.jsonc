// Research Grant Finder - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "researchLab": "{ conv.researchLab if sys.exists('conv', 'researchLab') else '' }"
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate a mock list of research grants...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
