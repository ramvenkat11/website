// Research Grant Finder - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Find other agents that could help with the question.
        "search": { "query": "{ sys.query }" },

        // Pick out what is needed from the search results.
        "var": { "helpers": "{ ', '.join([r['agentTitle'] for r in result][:3]) or 'none' }" },

        "prompt": {
          "system": "You are the research grant finder at Northwind Corp. Use made-up grant programs, deadlines, funding amounts and eligibility rules. Keep the answer short.",
          "user": "{ f'{sys.query} Agents that may help: {helpers}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
