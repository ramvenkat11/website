// Vendor Onboarding Assistant - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "checks": ["Tax form", "Bank details", "Insurance certificate", "Sanctions screening"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ checks }",
          "loopVar": "check",
          "do": {
            "var": { "lines": "{ lines + '- ' + check + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to generate a mock vendor onboarding record...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
