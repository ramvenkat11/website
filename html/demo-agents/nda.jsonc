// NDA Generator - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "ndaKind": "{ conv.ndaKind if sys.exists('conv', 'ndaKind') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "ndaKind": "{ facts['ndaKind'] if 'ndaKind' in facts and facts['ndaKind'] else ndaKind }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ ndaKind == '' }",
          "then": {
            "ask": {
              "message": "What kind of NDA?",
              "inputs": [ { "name": "ndaKind", "type": "chooseOne", "options": ["Mutual", "One-way", "Not sure"] } ]
            },
            "var": { "ndaKind": "{ result['ndaKind'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.ndaKind": "{ ndaKind }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ ndaKind == 'Not sure' }",
          "then": { "end": "Ask the legal team which kind fits before drafting." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the kind of NDA the user wants.",
      "args": {
        "ndaKind": { "type": "str", "required": false, "description": "The kind of NDA the user wants, exactly one of: Mutual (both sides share confidential information), One-way (only one side shares confidential information), Not sure (the user says they do not know which kind). Empty if not stated." }
      }
    }
  }
}
