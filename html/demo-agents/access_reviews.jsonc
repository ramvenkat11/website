// User Access Review Assistant - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "accessSystem": "{ conv.accessSystem if sys.exists('conv', 'accessSystem') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "accessSystem": "{ facts['accessSystem'] if 'accessSystem' in facts and facts['accessSystem'] else accessSystem }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ accessSystem == '' }",
          "then": {
            "ask": {
              "message": "Which system are you reviewing?",
              "inputs": [ { "name": "accessSystem", "type": "str", "description": "For example ERP, CRM, Payroll or Code repository." } ]
            },
            "var": { "accessSystem": "{ result['accessSystem'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.accessSystem": "{ accessSystem }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the system whose user access the user is reviewing.",
      "args": {
        "accessSystem": { "type": "str", "required": false, "description": "The system whose user access is being reviewed, for example CRM or Payroll. Empty if unknown." }
      }
    }
  }
}
