// Security Incident Reporter - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "securityIncident": "{ conv.securityIncident if sys.exists('conv', 'securityIncident') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "securityIncident": "{ facts['securityIncident'] if 'securityIncident' in facts and facts['securityIncident'] else securityIncident }",
          "attackInProgress": "{ facts['attackInProgress'] if 'attackInProgress' in facts and facts['attackInProgress'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ securityIncident == '' }",
          "then": {
            "ask": {
              "message": "What happened?",
              "inputs": [ { "name": "securityIncident", "type": "str", "description": "For example Lost or stolen device, Malware warning or Attack in progress." } ]
            },
            "var": { "securityIncident": "{ result['securityIncident'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "attackInProgress": "{ facts['attackInProgress'] if 'attackInProgress' in facts and facts['attackInProgress'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.securityIncident": "{ securityIncident }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ attackInProgress == True }",
          "then": { "end": "Call the security operations hotline now on extension 5000. Do not turn off the affected computer." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the security incident the user is reporting.",
      "args": {
        "securityIncident": { "type": "str", "required": false, "description": "What happened, for example a lost or stolen device or a malware warning. Empty if unknown." },
        "attackInProgress": { "type": "bool | null", "required": false, "description": "True if an attack is happening right now, false if not, null when neither the message nor the known facts say." }
      }
    }
  }
}
