// Foreign Exchange Rate Lookup - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "fromCurrency": "{ conv.fromCurrency if sys.exists('conv', 'fromCurrency') else '' }",
          "toCurrency": "{ conv.toCurrency if sys.exists('conv', 'toCurrency') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "fromCurrency": "{ facts['fromCurrency'] if 'fromCurrency' in facts and facts['fromCurrency'] else fromCurrency }",
          "toCurrency": "{ facts['toCurrency'] if 'toCurrency' in facts and facts['toCurrency'] else toCurrency }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ toCurrency == '' }",
          "then": {
            "ask": {
              "message": "Converting to which currency?",
              "inputs": [ { "name": "toCurrency", "type": "str", "description": "For example USD, EUR, GBP or JPY." } ]
            },
            "var": { "toCurrency": "{ result['toCurrency'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.fromCurrency": "{ fromCurrency }", "conv.toCurrency": "{ toCurrency }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ toCurrency.strip().upper() == 'USD' and fromCurrency.strip().upper() in ['USD', ''] }",
          "then": { "end": "Our books are already in USD, so no conversion is needed." }
        },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the currencies the user is converting between.",
      "args": {
        "fromCurrency": { "type": "str", "required": false, "description": "The currency the user is converting from, as its code, for example USD or EUR. Empty if unknown." },
        "toCurrency": { "type": "str", "required": false, "description": "The currency the user wants to convert to, or get the rate in, as its code, for example USD or JPY. Empty if unknown." }
      }
    }
  }
}
