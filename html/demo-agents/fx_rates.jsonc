// Foreign Exchange Rate Lookup - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says which currencies it names.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "to_currency": {
                "type": "choice",
                "instructions": "Which currency the user wants to convert to, or get the rate in",
                "criteria": {
                  "USD": "The message names US dollars as the currency to convert to",
                  "another currency": "The message names a currency other than US dollars to convert to",
                  "not stated": "The message does not name the currency to convert to"
                }
              },
              "from_currency": {
                "type": "choice",
                "instructions": "Which currency the user is converting from",
                "criteria": {
                  "USD": "The message names US dollars as the currency to convert from",
                  "another currency": "The message names a currency other than US dollars to convert from",
                  "not stated": "The message does not name the currency to convert from"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "to": "{ jev['to_currency']['choice'] if 'to_currency' in jev and 'choice' in jev['to_currency'] else 'not stated' }",
          "source": "{ jev['from_currency']['choice'] if 'from_currency' in jev and 'choice' in jev['from_currency'] else 'not stated' }",
          "currency": ""
        },

        // Ask the user only when the message does not name the target currency.
        "if.2": {
          "condition": "{ to == 'not stated' }",
          "then": {
            "ask": {
              "message": "Converting to which currency?",
              "inputs": [ { "name": "currency", "type": "str", "description": "For example USD, EUR, GBP or JPY." } ]
            },
            "var": {
              "currency": "{ result['currency'] }",
              "to": "{ 'USD' if result['currency'].strip().upper() == 'USD' else 'another currency' }"
            }
          }
        },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ to == 'USD' and source in ['USD', 'not stated'] }",
          "then": { "end": "Our books are already in USD, so no conversion is needed." }
        },

        "prompt": {
          "system": "You are the foreign exchange rate lookup at Northwind Corp. Our books are kept in USD; if the message does not name the currency to convert from, convert from USD. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (converting to: {currency})' if currency else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
