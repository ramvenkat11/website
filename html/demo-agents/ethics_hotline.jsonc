// Ethics Hotline Intake - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "ethicsTopic": "{ conv.ethicsTopic if sys.exists('conv', 'ethicsTopic') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "ethicsTopic": "{ facts['ethicsTopic'] if 'ethicsTopic' in facts and facts['ethicsTopic'] else ethicsTopic }",
          "danger": "{ facts['danger'] if 'danger' in facts and facts['danger'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ ethicsTopic == '' }",
          "then": {
            "ask": {
              "message": "What is your concern about?",
              "inputs": [ { "name": "ethicsTopic", "type": "str", "description": "For example Fraud, Harassment, Safety or Conflict of interest." } ]
            },
            "var": { "ethicsTopic": "{ result['ethicsTopic'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "danger": "{ facts['danger'] if 'danger' in facts and facts['danger'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.ethicsTopic": "{ ethicsTopic }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ danger == True }",
          "then": { "end": "Call emergency services now, then Northwind Security on extension 5555." }
        },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records what the user's ethics concern is about.",
      "args": {
        "ethicsTopic": { "type": "str", "required": false, "description": "What the user's concern is about, for example harassment or fraud. Empty if unknown." },
        "danger": { "type": "bool | null", "required": false, "description": "True if someone is in danger right now, False if nobody is, null when neither the message nor the known facts say." }
      }
    }
  }
}
