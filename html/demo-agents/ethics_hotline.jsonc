// Ethics Hotline Intake - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the concern, and whether someone is in danger now.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "topic": {
                "type": "choice",
                "instructions": "Whether the message names what the user's concern is about",
                "criteria": {
                  "stated": "The message names what the concern is about, for example harassment or fraud",
                  "not stated": "The message does not name what the concern is about"
                }
              },
              "danger": {
                "type": "choice",
                "instructions": "Whether someone is in danger right now",
                "criteria": {
                  "Yes": "Someone is in danger right now",
                  "No": "Nobody is in danger right now",
                  "cannot tell": "The message does not say enough to tell"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "topicStated": "{ jev['topic']['choice'] if 'topic' in jev and 'choice' in jev['topic'] else 'not stated' }",
          "danger": "{ jev['danger']['choice'] if 'danger' in jev and 'choice' in jev['danger'] else 'cannot tell' }",
          "topic": ""
        },

        // Ask the user only when the message does not name the concern.
        "if.2": {
          "condition": "{ topicStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "What is your concern about?",
              "inputs": [ { "name": "topic", "type": "str", "description": "For example Fraud, Harassment, Safety or Conflict of interest." } ]
            },
            "var": { "topic": "{ result['topic'] }" }
          }
        },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ danger == 'Yes' }",
          "then": { "end": "Call emergency services now, then Northwind Security on extension 5555." }
        },

        // The LLM reads the concern from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the ethics hotline intake at Northwind Corp. Use made-up data. Explain how to report the concern anonymously, what happens next, and that retaliation is not allowed. If someone is in danger now, first tell the user to call emergency services now, then Northwind Security on extension 5555. Keep the answer short.",
          "user": "{ f'{sys.query} (concern: {topic})' if topic else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
