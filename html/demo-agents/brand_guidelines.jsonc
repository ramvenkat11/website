// Brand Guideline Checker - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "rules": ["Logo spacing", "Brand colors", "Fonts", "Tone of voice"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ rules }",
          "loopVar": "rule",
          "do": {
            "var": { "lines": "{ lines + '- ' + rule + '\\n' }" }
          }
        },

        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
