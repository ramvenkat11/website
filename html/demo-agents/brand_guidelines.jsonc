// Brand Guideline Checker - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "rules": ["Logo spacing", "Brand colors", "Fonts", "Tone of voice"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ rules }",
          "loopVar": "rule",
          "do": {
            "var": { "lines": "{ lines + '- ' + rule + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the brand guideline checker at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
