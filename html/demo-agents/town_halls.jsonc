// Town Hall Q&A Preparer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "topics": ["Company results", "Reorganization", "Return to office", "Pay and bonuses"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ topics }",
          "loopVar": "topic",
          "do": {
            "var": { "lines": "{ lines + '- ' + topic + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock town hall questions and answers...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
