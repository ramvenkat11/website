// On-Call Schedule Lookup - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "team": "{ conv.team if sys.exists('conv', 'team') else '' }"
        },

        // A number and a list used below.
        "var.2": { "offset": 0, "slots": [] },

        // Loop over dates, skipping some with continue and stopping with break.
        "while": {
          "condition": "{ True }",
          "do": {
            "var": { "offset": "{ offset + 1 }" },
            "continue": "{ (datetime.now().date() + timedelta(days=offset)).weekday() >= 5 }",
            "var.2": { "slots": "{ slots + [['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][(datetime.now().date() + timedelta(days=offset)).weekday()] + ' ' + (datetime.now().date() + timedelta(days=offset)).isoformat()] }" },
            "break": "{ len(slots) >= 5 }"
          }
        },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
