// Prospect Account Researcher - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "overview": { "question": "{ sys.query }" },
          "contacts": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "overviewView": "{ result['overview'] }", "contactsView": "{ result['contacts'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to combine the 2 results into one answer...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "overview": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Anthropic claude-haiku-4-5 to describe the company in a few lines (mock data)...",
        "llm": { "profile": "claude_haiku", "prompt": "overview" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "contacts": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Anthropic claude-haiku-4-5 to list likely decision makers (mock data)...",
        "llm": { "profile": "claude_haiku", "prompt": "contacts" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
