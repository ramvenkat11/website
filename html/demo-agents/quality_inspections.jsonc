// Quality Inspection Logger - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "inspection line", "label": "inspection_line", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "line": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which production line?",
              "inputs": [ { "name": "line", "type": "chooseOne", "options": ["Line A", "Line B", "Line C"] } ]
            },
            "var": { "line": "{ result['line'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "inspection_line": "{ line }" } }
          }
        },

        "prompt": {
          "system": "You are the quality inspection logger at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers line: {line}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
