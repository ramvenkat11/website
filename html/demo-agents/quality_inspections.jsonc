// Quality Inspection Logger - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the production line.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "line": {
                "type": "choice",
                "instructions": "Whether the message names the production line the inspection is for",
                "criteria": {
                  "stated": "The message names the production line the inspection is for, for example Line A or Line D",
                  "not stated": "The message does not name a production line"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "lineStated": "{ jev['line']['choice'] if 'line' in jev and 'choice' in jev['line'] else 'not stated' }",
          "line": ""
        },

        // Ask the user only when the message does not name the line.
        "if.2": {
          "condition": "{ lineStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which production line?",
              "inputs": [ { "name": "line", "type": "str", "description": "For example Line A, Line B or Line C." } ]
            },
            "var": { "line": "{ result['line'] }" }
          }
        },

        // The LLM reads the line from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the quality inspection logger at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers line: {line}.' if line else sys.query }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
