// Database Query Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Kept for this agent across the conversation.
        "var": { "agent.visits": "{ agent.visits + 1 if sys.exists('agent', 'visits') else 1 }" },

        // Shared by every agent in the conversation.
        "var.2": { "conv.lastTopic": "SQL queries" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate a mock SQL query...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
