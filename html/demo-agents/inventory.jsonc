// Inventory Level Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "units": "{ randint(0, 500) }" },

        // Tell the user what is happening while they wait.
        "progress": "{ f'Found {units} units in stock...' }",

        "prompt": {
          "system": "You are the inventory level checker at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} There are {units} units in stock.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
