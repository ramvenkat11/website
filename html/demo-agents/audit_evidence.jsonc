// Audit Evidence Collector - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "audit area", "label": "audit_area", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "area": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which audit area are you working on?",
              "inputs": [ { "name": "area", "type": "chooseOne", "options": ["Revenue", "Payroll", "Procurement", "IT controls"] } ]
            },
            "var": { "area": "{ result['area'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "audit_area": "{ area }" } }
          }
        },

        "prompt": {
          "system": "You are the audit evidence collector at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers area: {area}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
