// Cash Flow Summarizer - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "days": "{ randint(30, 90) }" },

        // Tell the user what is happening while they wait.
        "progress": "{ f'Found {days} days of cash on hand...' }",

        "prompt": {
          "system": "You are the cash flow summarizer at Northwind Corp. Use made-up data. Keep the answer short. Answer in plain text, not JSON or code.",
          "user": "{ f'{sys.query} There are {days} days of cash on hand.' }"
        },
        "llm": { "profile": "ollama_nemotron", "streamOutput": true }
      }
    }
  }
}
