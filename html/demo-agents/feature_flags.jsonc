// Feature Flag Manager - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "deployEnvironment": "{ conv.deployEnvironment if sys.exists('conv', 'deployEnvironment') else '' }"
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to find your environment in your message...",

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "deployEnvironment": "{ facts['deployEnvironment'] if 'deployEnvironment' in facts and facts['deployEnvironment'] else deployEnvironment }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ deployEnvironment == '' }",
          "then": {
            "ask": {
              "message": "Which environment do you use?",
              "inputs": [ { "name": "deployEnvironment", "type": "str", "description": "For example Development, Staging or Production." } ]
            },
            "var": { "deployEnvironment": "{ result['deployEnvironment'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.deployEnvironment": "{ deployEnvironment }" },

        "progress.2": "Asking Google gemini-3.6-flash to generate mock feature flag settings...",
        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the environment the user works in.",
      "args": {
        "deployEnvironment": { "type": "str", "required": false, "description": "The environment the user works in, for example Staging or Production. Empty if unknown." }
      }
    }
  }
}
