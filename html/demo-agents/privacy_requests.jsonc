// Personal Data Request Handler - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "deadline_days", "args": { "received": 3 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock data as an agent that handles a person's request to see, correct or delete the personal data the company holds about them, and tracks the legal response deadline...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "deadline_days": {
      "args": { "received": { "type": "int" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ 30 - received }"
      }
    }
  }
}
