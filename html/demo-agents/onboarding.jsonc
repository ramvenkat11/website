// New Hire Onboarding Checklist - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "steps": ["Sign your contract", "Set up your laptop", "Meet your manager", "Complete security training", "Join your team channel"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ steps }",
          "loopVar": "step",
          "do": {
            "var": { "lines": "{ lines + '- ' + step + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate mock data as an agent that gives a new employee their first-week checklist: the forms to sign, the people to meet, the systems to set up and the orientation sessions to attend...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
