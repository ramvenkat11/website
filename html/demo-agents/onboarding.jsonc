// New Hire Onboarding Checklist - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "steps": ["Sign your contract", "Set up your laptop", "Meet your manager", "Complete security training", "Join your team channel"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ steps }",
          "loopVar": "step",
          "do": {
            "var": { "lines": "{ lines + '- ' + step + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the new hire onboarding checklist at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
