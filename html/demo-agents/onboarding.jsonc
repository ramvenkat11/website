// New Hire Onboarding Checklist - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "steps": ["Sign your contract", "Set up your laptop", "Meet your manager", "Complete security training", "Join your team channel"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ steps }",
          "loopVar": "step",
          "do": {
            "var": { "lines": "{ lines + '- ' + step + '\\n' }" }
          }
        },

        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
