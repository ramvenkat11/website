// Emergency Procedures Guide - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "steps": { "question": "{ sys.query }" },
          "contacts": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "stepsView": "{ result['steps'] }", "contactsView": "{ result['contacts'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to combine the 2 results into one answer...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "steps": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to list the steps to take right now (mock data)...",
        "llm": { "profile": "gpt5_mini", "prompt": "steps" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "contacts": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to list whom to call (mock data)...",
        "llm": { "profile": "gpt5_mini", "prompt": "contacts" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
