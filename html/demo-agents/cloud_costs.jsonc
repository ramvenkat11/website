// Cloud Cost Reporter - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "team": "{ conv.team if sys.exists('conv', 'team') else '' }",
          "deployEnvironment": "{ conv.deployEnvironment if sys.exists('conv', 'deployEnvironment') else '' }"
        },

        // Call a function with arguments.
        "func": { "name": "monthly_cost", "args": { "hours": 720, "rate": 0.46 } },

        // Use the value the function returned.
        "var.2": { "figure": "{ result }" },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "monthly_cost": {
      "args": { "hours": { "type": "int" }, "rate": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(hours * rate, 2) }"
      }
    }
  }
}
