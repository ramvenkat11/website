// Lost and Found Desk - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Find other agents that could help with the question.
        "search": { "query": "{ sys.query }" },

        // Pick out what is needed from the search results.
        "var": { "helpers": "{ ', '.join([r['agentTitle'] for r in result][:3]) or 'none' }" },

        "prompt": {
          "system": "You are the lost and found desk at Northwind Corp. Help with items lost or found in the office. Keep the answer short. Answer in plain text, not JSON or code.",
          "user": "{ f'{sys.query} Agents that may help: {helpers}.' }"
        },
        "llm": { "profile": "ollama_nemotron", "streamOutput": true }
      }
    }
  }
}
