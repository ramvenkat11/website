// Gifts and Hospitality Register - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "needs_approval", "args": { "value": 180.0, "limit": 100.0 } },

        // Use the value the function returned.
        "var": { "approval": "{ result }" },

        // Branch on a condition.
        "if": {
          "condition": "{ approval }",
          "then": { "var": { "rule": "above the limit, so it needs compliance approval" } },
          "else": { "var": { "rule": "within the limit, so it only needs to be recorded" } }
        },

        "prompt": {
          "system": "You are the gifts and hospitality register at Northwind Corp. Use made-up data. Record gifts, meals and events given or received, and explain the limits. Keep the answer short.",
          "user": "{ f'{sys.query} An example gift worth $180 is {rule}.' }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "needs_approval": {
      "args": { "value": { "type": "float" }, "limit": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ value > limit }"
      }
    }
  }
}
