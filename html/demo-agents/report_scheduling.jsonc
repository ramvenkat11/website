// Scheduled Report Setup - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Ask the user for what the agent needs.
        "ask": {
          "message": "How often should the report be sent?",
          "inputs": [ { "name": "frequency", "type": "chooseOne", "options": ["Daily", "Weekly", "Monthly", "Every hour"] } ]
        },

        "var": { "frequency": "{ result['frequency'] }" },

        // Stop with an error the user sees.
        "if": {
          "condition": "{ frequency == 'Every hour' }",
          "then": { "fail": "Hourly report emails are not allowed. Use a live dashboard instead." }
        },

        "prompt": {
          "system": "You are the scheduled report setup assistant at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (frequency: {frequency})' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
