// Scheduled Report Setup - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "reportFrequency": "{ conv.reportFrequency if sys.exists('conv', 'reportFrequency') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "reportFrequency": "{ facts['reportFrequency'] if 'reportFrequency' in facts and facts['reportFrequency'] else reportFrequency }",
          "hourly": "{ facts['hourly'] if 'hourly' in facts and facts['hourly'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ reportFrequency == '' }",
          "then": {
            "ask": {
              "message": "How often should the report be sent?",
              "inputs": [ { "name": "reportFrequency", "type": "str", "description": "For example Daily, Weekly, Monthly or Every hour." } ]
            },
            "var": { "reportFrequency": "{ result['reportFrequency'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "hourly": "{ facts['hourly'] if 'hourly' in facts and facts['hourly'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.reportFrequency": "{ reportFrequency }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ hourly == True }",
          "then": { "fail": "Hourly report emails are not allowed. Use a live dashboard instead." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records how often the user wants the report sent.",
      "args": {
        "reportFrequency": { "type": "str", "required": false, "description": "How often the user wants the report sent, for example weekly or every quarter. Empty if unknown." },
        "hourly": { "type": "bool | null", "required": false, "description": "True if the report should be sent hourly or more often, false if less often, null when neither the message nor the known facts say." }
      }
    }
  }
}
