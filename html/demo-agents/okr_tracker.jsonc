// Company OKR Tracker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "progress", "args": { "done": 7.0, "target": 12.0 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate mock data as an agent that shows the company's objectives and key results for the quarter, how far along each one is and which are at risk of being missed...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "progress": {
      "args": { "done": { "type": "float" }, "target": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(done / target * 100) }"
      }
    }
  }
}
