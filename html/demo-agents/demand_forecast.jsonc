// Demand Forecaster - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "salesRegion": "{ conv.salesRegion if sys.exists('conv', 'salesRegion') else '' }"
        },

        // Past monthly sales.
        "var.2": { "history": [1180, 1245, 1310, 1290, 1402, 1455] },

        // Call a function with arguments.
        "func": { "name": "trend", "args": { "units": "{ history }" } },

        // Use the value the function returned.
        "var.3": { "growth": "{ result }" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "trend": {
      "args": { "units": { "type": "list[int]" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round((units[-1] / units[0]) ** (1 / (len(units) - 1)) * 100 - 100, 1) }"
      }
    }
  }
}
