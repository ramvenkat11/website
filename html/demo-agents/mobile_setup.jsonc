// Mobile Device Setup Guide - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "device": "{ conv.device if sys.exists('conv', 'device') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "device": "{ facts['device'] if 'device' in facts and facts['device'] else device }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ device == '' }",
          "then": {
            "ask": {
              "message": "Which device?",
              "inputs": [ { "name": "device", "type": "str", "description": "For example Any, iPhone, Android or iPad." } ]
            },
            "var": { "device": "{ result['device'] }" }
          }
        },

        "var.5": { "deviceScope": "{ 'any' if device.strip().lower() == 'any' else ('one device' if device else 'not stated') }" },

        // Branch on a condition.
        "if.3": {
          "condition": "{ deviceScope == 'any' }",
          "then": { "var": { "focus": " Focus on any device." } },
          "else": { "var": { "focus": "{ f' Focus on {device.lower()}.' if device else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.device": "{ device }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the device the user is setting up.",
      "args": {
        "device": { "type": "str", "required": false, "description": "The device the user is setting up, for example an iPhone or a Pixel 8, or any when the user says any device. Empty if unknown." }
      }
    }
  }
}
