// Mobile Device Setup Guide - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // Pause for the user's answer.
        "ask": {
          "message": "Which device?",
          "inputs": [
            { "name": "device", "type": "chooseOne", "options": ["Any", "iPhone", "Android", "iPad"], "default": "Any" }
          ]
        },

        // Keep the result in a variable.
        "var.2": { "device": "{ result['device'] }" },

        // Branch on a condition.
        "if": {
          "condition": "{ device == 'Any' }",
          "then": { "var": { "focus": "any device" } },
          "else": { "var": { "focus": "{ device.lower() }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        "prompt": {
          "system": "{ f'You are the mobile device setup guide at {company}. Use made-up data. Keep the answer short.' }",
          "user": "{ f'{sys.query} Focus on {focus}.' }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
