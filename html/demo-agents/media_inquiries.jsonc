// Media Inquiry Responder - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'media_inquiries asked: ' + sys.query[:80] }" },

        // Jev reads the message and says whether it says when the reporter needs a reply.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "deadline": {
                "type": "choice",
                "instructions": "Whether the message says when the reporter needs a reply",
                "criteria": {
                  "stated": "The message says when the reporter needs a reply, for example today or Friday noon, or says there is no deadline",
                  "not stated": "The message does not say when the reporter needs a reply"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "deadlineStated": "{ jev['deadline']['choice'] if 'deadline' in jev and 'choice' in jev['deadline'] else 'not stated' }",
          "deadline": ""
        },

        // Ask the user only when the message does not say the deadline.
        "if.2": {
          "condition": "{ deadlineStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Is the reporter on deadline?",
              "inputs": [ { "name": "deadline", "type": "str", "description": "For example Today, This week or No deadline." } ]
            },
            "var": { "deadline": "{ result['deadline'] }" }
          }
        },

        // The LLM reads the deadline from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the media inquiry responder at Northwind Corp. Use made-up data. Say who should respond, what can be said on the record, and draft a short reply to the reporter. Keep the answer short.",
          "user": "{ f'{sys.query} Deadline: {deadline}.' if deadline else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
