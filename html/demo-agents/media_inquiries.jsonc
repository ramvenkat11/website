// Media Inquiry Responder - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'media_inquiries asked: ' + sys.query[:80] }" },

        // What this or another agent already learned in this conversation.
        "var": {
          "replyDeadline": "{ conv.replyDeadline if sys.exists('conv', 'replyDeadline') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "replyDeadline": "{ facts['replyDeadline'] if 'replyDeadline' in facts and facts['replyDeadline'] else replyDeadline }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ replyDeadline == '' }",
          "then": {
            "ask": {
              "message": "Is the reporter on deadline?",
              "inputs": [ { "name": "replyDeadline", "type": "str", "description": "For example Today, This week or No deadline." } ]
            },
            "var": { "replyDeadline": "{ result['replyDeadline'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.replyDeadline": "{ replyDeadline }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records when the reporter needs a reply.",
      "args": {
        "replyDeadline": { "type": "str", "required": false, "description": "When the reporter needs a reply, for example today or Friday noon, or no deadline. Empty if unknown." }
      }
    }
  }
}
