// Customer Due Diligence Helper - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "customerType": "{ conv.customerType if sys.exists('conv', 'customerType') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "customerType": "{ facts['customerType'] if 'customerType' in facts and facts['customerType'] else customerType }",
          "largeEntity": "{ facts['largeEntity'] if 'largeEntity' in facts and facts['largeEntity'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ customerType == '' }",
          "then": {
            "ask": {
              "message": "What kind of customer is this?",
              "inputs": [ { "name": "customerType", "type": "str", "description": "For example Individual, Small business, Corporation or Government body." } ]
            },
            "var": { "customerType": "{ result['customerType'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "largeEntity": "{ facts['largeEntity'] if 'largeEntity' in facts and facts['largeEntity'] is not None else None }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ largeEntity == True }",
          "then": { "var": { "depth": "enhanced due diligence, including beneficial owners" } },
          "else": {
            "if": {
              "condition": "{ largeEntity == False }",
              "then": { "var": { "depth": "standard identity and address checks" } },
              "else": { "var": { "depth": "enhanced due diligence, including beneficial owners, for a corporation or government body, otherwise standard identity and address checks" } }
            }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.customerType": "{ customerType }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the kind of customer being onboarded.",
      "args": {
        "customerType": { "type": "str", "required": false, "description": "The kind of customer being onboarded, for example an individual, a small business or a charity. Empty if unknown." },
        "largeEntity": { "type": "bool | null", "required": false, "description": "True if the customer is a corporation or a government body, False if it is something else, null when neither the message nor the known facts say." }
      }
    }
  }
}
