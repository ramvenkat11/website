// Policy Attestation Tracker - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "policies": ["Code of Conduct", "Acceptable Use", "Anti-Bribery", "Data Handling"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ policies }",
          "loopVar": "policy",
          "do": {
            "var": { "lines": "{ lines + '- ' + policy + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the policy attestation tracker at Northwind Corp. Use made-up data. Show what share of employees have signed each policy this year, who is overdue, and when reminders go out. Keep the answer short. Answer in plain text, not JSON or code.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "ollama_nemotron", "streamOutput": true }
      }
    }
  }
}
