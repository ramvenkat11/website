// Policy Attestation Tracker - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "policies": ["Code of Conduct", "Acceptable Use", "Anti-Bribery", "Data Handling"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ policies }",
          "loopVar": "policy",
          "do": {
            "var": { "lines": "{ lines + '- ' + policy + '\\n' }" }
          }
        },

        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
