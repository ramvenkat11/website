// Policy Attestation Tracker - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "policies": ["Code of Conduct", "Acceptable Use", "Anti-Bribery", "Data Handling"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ policies }",
          "loopVar": "policy",
          "do": {
            "var": { "lines": "{ lines + '- ' + policy + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Ollama gemma4:31b to generate mock data as an agent that shows which employees have signed this year's required policies, such as the code of conduct, who is overdue, and when reminders go out...",
        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
