// Benefits Enrollment Guide - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "benefit": "{ conv.benefit if sys.exists('conv', 'benefit') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "benefit": "{ facts['benefit'] if 'benefit' in facts and facts['benefit'] else benefit }"
        },
        "var.5": { "benefitScope": "{ 'not stated' if benefit == '' else ('all' if benefit.strip().lower() == 'all' else 'one benefit') }" },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ benefit == '' }",
          "then": {
            "ask": {
              "message": "Which benefit?",
              "inputs": [
              { "name": "benefit", "type": "str", "description": "For example All, Health, Dental, Vision or Retirement." }
            ]
            },
            "var": {
              "benefit": "{ result['benefit'] }",
              "benefitScope": "{ 'all' if result['benefit'].strip().lower() == 'all' else 'one benefit' }"
            }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ benefitScope == 'all' }",
          "then": { "var": { "focus": " Focus on every benefit." } },
          "else": { "var": { "focus": "{ f' Focus on {benefit.lower()}.' if benefit else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.benefit": "{ benefit }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records which benefit the user asks about.",
      "args": {
        "benefit": { "type": "str", "required": false, "description": "The benefit the user asks about, for example dental, health or retirement, or 'all' when the user asks about every benefit. Empty if unknown." }
      }
    }
  }
}
