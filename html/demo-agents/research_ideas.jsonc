// Research Idea Evaluator - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "feasibility": { "question": "{ sys.query }" },
          "novelty": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "output": "{ '## Feasibility\\n' + result['feasibility'] + '\\n\\n## Novelty\\n' + result['novelty'] }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "feasibility": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gpt5_mini", "prompt": "feasibility" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "novelty": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gpt5_mini", "prompt": "novelty" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
