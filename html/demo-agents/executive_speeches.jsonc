// Executive Speech Writer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "speaker", "label": "speaker", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "speaker": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Who usually gives the speeches you write?",
              "inputs": [ { "name": "speaker", "type": "chooseOne", "options": ["CEO", "CFO", "CTO", "Head of People"] } ]
            },
            "var": { "speaker": "{ result['speaker'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "speaker": "{ speaker }" } }
          }
        },

        "prompt": {
          "system": "You are the executive speech writer at Northwind Corp. Use made-up facts. Write remarks meant to be spoken aloud, with a strong opening and a clear close. Keep the answer short.",
          "user": "{ f'{sys.query} The speaker is the {speaker}.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
