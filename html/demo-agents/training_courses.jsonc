// Training Course Finder - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says which skill level it gives.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "level": {
                "type": "choice",
                "instructions": "The user's skill level",
                "criteria": {
                  "Beginner": "The user is a beginner or new to the subject",
                  "Intermediate": "The user has some experience with the subject",
                  "Advanced": "The user is advanced or an expert",
                  "Not sure": "The user says they do not know their level",
                  "not stated": "The message does not say the user's level"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": { "level": "{ jev['level']['choice'] if 'level' in jev and 'choice' in jev['level'] else 'not stated' }" },

        // Ask the user only when the message does not say the level.
        "if.2": {
          "condition": "{ level == 'not stated' }",
          "then": {
            "ask": {
              "message": "What level are you?",
              "inputs": [ { "name": "level", "type": "chooseOne", "options": ["Beginner", "Intermediate", "Advanced", "Not sure"] } ]
            },
            "var": { "level": "{ result['level'] }" }
          }
        },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ level == 'Not sure' }",
          "then": { "end": "Take the skills check in the learning portal first, then ask again." }
        },

        "prompt": {
          "system": "You are the training course finder at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (level: {level})' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
