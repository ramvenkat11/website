// Desk Reservation Assistant - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "desk floor", "label": "desk_floor", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "floor": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which floor do you prefer?",
              "inputs": [ { "name": "floor", "type": "chooseOne", "options": ["Floor 1", "Floor 2", "Floor 3"] } ]
            },
            "var": { "floor": "{ result['floor'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "desk_floor": "{ floor }" } }
          }
        },

        "prompt": {
          "system": "You are the desk reservation assistant at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers floor: {floor}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
