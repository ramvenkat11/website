// Sales Call Notes Logger - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'call_notes asked: ' + sys.query[:80] }" },

        // Shown only when the agent is validated.
        "trace": "{ 'Question length: ' + str(len(sys.query)) }",

        "prompt": {
          "system": "You are the sales call notes logger at Northwind Corp. Use made-up data. Keep the answer short. Answer in plain text, not JSON or code.",
          "user": "{ sys.query }"
        },
        "llm": { "profile": "ollama_nemotron", "streamOutput": true }
      }
    }
  }
}
