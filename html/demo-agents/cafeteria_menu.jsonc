// Cafeteria Menu Lookup - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "dishes": "{ randint(6, 14) }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Ollama gemma4:31b to generate a mock cafeteria menu...",
        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
