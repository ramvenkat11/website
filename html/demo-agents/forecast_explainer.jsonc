// Sales Forecast Explainer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "forecast region", "label": "forecast_region", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "region": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which region do you follow?",
              "inputs": [ { "name": "region", "type": "chooseOne", "options": ["North America", "Europe", "Asia Pacific", "Latin America"] } ]
            },
            "var": { "region": "{ result['region'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "forecast_region": "{ region }" } }
          }
        },

        "prompt": {
          "system": "You are the sales forecast explainer at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user follows region: {region}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
