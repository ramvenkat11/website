// Crisis Communications Guide - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "crisisIncident": "{ conv.crisisIncident if sys.exists('conv', 'crisisIncident') else '' }"
        },

        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'crisis_comms asked: ' + sys.query[:80] }" },

        // Shown only when the agent is validated.
        "trace": "{ 'Question length: ' + str(len(sys.query)) }",

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock data as an agent that guides the leadership team through a crisis such as an outage, a data breach or bad press: who to inform, in what order, and a first statement to send...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
