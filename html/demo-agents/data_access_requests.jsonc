// Dataset Access Request Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "dataKind": "{ conv.dataKind if sys.exists('conv', 'dataKind') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "dataKind": "{ facts['dataKind'] if 'dataKind' in facts and facts['dataKind'] else dataKind }",
          "personalData": "{ facts['personalData'] if 'personalData' in facts and facts['personalData'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ dataKind == '' }",
          "then": {
            "ask": {
              "message": "What kind of data do you need?",
              "inputs": [ { "name": "dataKind", "type": "str", "description": "For example Aggregated reports, Raw event data or Finance tables." } ]
            },
            "var": { "dataKind": "{ result['dataKind'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "personalData": "{ facts['personalData'] if 'personalData' in facts and facts['personalData'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.dataKind": "{ dataKind }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ personalData == True }",
          "then": { "end": "Access to customer personal data goes through the privacy office. Please file a privacy review first." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the data the user needs access to.",
      "args": {
        "dataKind": { "type": "str", "required": false, "description": "The kind of data the user needs, for example raw event data or finance tables. Empty if unknown." },
        "personalData": { "type": "bool | null", "required": false, "description": "True if the data needed includes customer personal data, False if it does not, null when neither the message nor the known facts say." }
      }
    }
  }
}
