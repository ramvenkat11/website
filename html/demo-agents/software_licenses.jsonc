// Software License Requester - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "team software", "label": "team_software", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "team": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which team are you in?",
              "inputs": [ { "name": "team", "type": "chooseOne", "options": ["Engineering", "Design", "Sales", "Finance"] } ]
            },
            "var": { "team": "{ result['team'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "team_software": "{ team }" } }
          }
        },

        "prompt": {
          "system": "You are the software license requester at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers team: {team}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
