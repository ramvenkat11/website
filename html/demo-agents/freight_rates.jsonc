// Freight Rate Finder - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "shippingMode": "{ conv.shippingMode if sys.exists('conv', 'shippingMode') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "shippingMode": "{ facts['shippingMode'] if 'shippingMode' in facts and facts['shippingMode'] else shippingMode }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ shippingMode == '' }",
          "then": {
            "ask": {
              "message": "How will the goods travel?",
              "inputs": [ { "name": "shippingMode", "type": "chooseOne", "options": ["Ocean", "Air", "Truck", "Rail"], "default": "Ocean" } ]
            },
            "var": { "shippingMode": "{ result['shippingMode'] }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ shippingMode == 'Air' }",
          "then": { "var": { "unit": "per kilogram" } },
          "else": { "var": { "unit": "per container or truckload" } }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.shippingMode": "{ shippingMode }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records how the goods will travel.",
      "args": {
        "shippingMode": { "type": "str", "required": false, "description": "How the goods will travel: exactly one of Ocean (by sea or ship), Air (air freight or express courier), Truck (by road) or Rail. Empty if not stated." }
      }
    }
  }
}
