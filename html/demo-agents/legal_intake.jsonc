// Legal Matter Intake - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it says which team the user is in.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "team": {
                "type": "choice",
                "instructions": "Whether the message says which team the user is in",
                "criteria": {
                  "stated": "The message says which team the user is in, for example Engineering or Sales",
                  "not stated": "The message does not say which team the user is in"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "teamStated": "{ jev['team']['choice'] if 'team' in jev and 'choice' in jev['team'] else 'not stated' }",
          "team": ""
        },

        // Ask the user only when the message does not say which team.
        "if.2": {
          "condition": "{ teamStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which team are you in?",
              "inputs": [ { "name": "team", "type": "str", "description": "For example Sales, Engineering, HR or Finance." } ]
            },
            "var": { "team": "{ result['team'] }" }
          }
        },

        // The LLM reads the team from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the legal matter intake at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers team: {team}.' if team else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
