// Legal Matter Intake - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "legal team", "label": "legal_team", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "team": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which team are you in?",
              "inputs": [ { "name": "team", "type": "chooseOne", "options": ["Sales", "Engineering", "HR", "Finance"] } ]
            },
            "var": { "team": "{ result['team'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "legal_team": "{ team }" } }
          }
        },

        "prompt": {
          "system": "You are the legal matter intake at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers team: {team}.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
