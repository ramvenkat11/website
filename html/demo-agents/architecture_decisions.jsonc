// Architecture Decision Record Writer - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "architectureArea": "{ conv.architectureArea if sys.exists('conv', 'architectureArea') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "architectureArea": "{ facts['architectureArea'] if 'architectureArea' in facts and facts['architectureArea'] else architectureArea }"
        },
        "var.5": { "architectureAreaScope": "{ 'not stated' if architectureArea == '' else ('any' if architectureArea.strip().lower() == 'any' else 'one kind') }" },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ architectureArea == '' }",
          "then": {
            "ask": {
              "message": "What kind of decision?",
              "inputs": [
              { "name": "architectureArea", "type": "str", "description": "For example Any, Database, Messaging or Hosting." }
            ]
            },
            "var": {
              "architectureArea": "{ result['architectureArea'] }",
              "architectureAreaScope": "{ 'any' if result['architectureArea'].strip().lower() == 'any' else 'one kind' }"
            }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ architectureAreaScope == 'any' }",
          "then": { "var": { "focus": " Focus on any decision." } },
          "else": { "var": { "focus": "{ f' Focus on {architectureArea.lower()}.' if architectureArea else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.architectureArea": "{ architectureArea }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records which area the architecture decision is about.",
      "args": {
        "architectureArea": { "type": "str", "required": false, "description": "The area the architecture decision is about, for example database, messaging or hosting, or 'any' when the user says any kind. Empty if unknown." }
      }
    }
  }
}
