// Leave Balance Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": {
          "company": "Northwind Corp",
          "year": 2026
        },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "leaveType": "{ conv.leaveType if sys.exists('conv', 'leaveType') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "leaveType": "{ facts['leaveType'] if 'leaveType' in facts and facts['leaveType'] else leaveType }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ leaveType == '' }",
          "then": {
            "ask": {
              "message": "Which leave balance?",
              "inputs": [ { "name": "leaveType", "type": "str", "description": "For example All, Vacation, Sick or Personal." } ]
            },
            "var": { "leaveType": "{ result['leaveType'] }" }
          }
        },

        "var.5": { "leaveScope": "{ 'all' if leaveType.strip().lower() == 'all' else ('one kind' if leaveType else 'not stated') }" },

        // Branch on a condition.
        "if.3": {
          "condition": "{ leaveScope == 'all' }",
          "then": { "var": { "focus": " Show all leave types." } },
          "else": { "var": { "focus": "{ f' Show {leaveType} leave.' if leaveType else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Checking your balance...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.leaveType": "{ leaveType }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records which leave balance the user asks about.",
      "args": {
        "leaveType": { "type": "str", "required": false, "description": "The kind of leave the user asks about, for example vacation, sick or parental, or all when they ask about every kind. Empty if unknown." }
      }
    }
  }
}
