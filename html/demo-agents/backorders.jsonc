// Backorder Tracker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "sales region", "label": "sales_region", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "region": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which region's customers do you serve?",
              "inputs": [ { "name": "region", "type": "chooseOne", "options": ["North America", "Europe", "Asia Pacific", "Latin America"] } ]
            },
            "var": { "region": "{ result['region'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "sales_region": "{ region }" } }
          }
        },

        "prompt": {
          "system": "You are the backorder tracker at Northwind Corp. Use made-up data. List customer orders waiting on out-of-stock items, the quantities short and the expected fill dates. Keep the answer short.",
          "user": "{ f'{sys.query} The user serves region: {region}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
