// Backorder Tracker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "salesRegion": "{ conv.salesRegion if sys.exists('conv', 'salesRegion') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "salesRegion": "{ facts['salesRegion'] if 'salesRegion' in facts and facts['salesRegion'] else salesRegion }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ salesRegion == '' }",
          "then": {
            "ask": {
              "message": "Which region's customers do you serve?",
              "inputs": [ { "name": "salesRegion", "type": "str", "description": "For example North America, Europe, Asia Pacific or Latin America." } ]
            },
            "var": { "salesRegion": "{ result['salesRegion'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.salesRegion": "{ salesRegion }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the sales region whose customers the user serves.",
      "args": {
        "salesRegion": { "type": "str", "required": false, "description": "The sales region whose customers the user serves, for example Europe or North America. Empty if unknown." }
      }
    }
  }
}
