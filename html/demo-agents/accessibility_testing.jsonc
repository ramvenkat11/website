// Accessibility Test Guide - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names what to check.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "check": {
                "type": "choice",
                "instructions": "Whether the message names what the user wants to check for accessibility",
                "criteria": {
                  "stated": "The message names what the user wants to check for accessibility, for example color contrast or keyboard navigation",
                  "not stated": "The message does not name anything to check"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "checkStated": "{ jev['check']['choice'] if 'check' in jev and 'choice' in jev['check'] else 'not stated' }",
          "check": ""
        },

        // Ask the user only when the message does not name what to check.
        "if.2": {
          "condition": "{ checkStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "What do you want to check?",
              "inputs": [ { "name": "check", "type": "str", "description": "For example Screen reader, Keyboard navigation, Color contrast or Captions." } ]
            },
            "var": { "check": "{ result['check'] }" }
          }
        },

        // The LLM reads the check from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the accessibility test guide at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (check: {check})' if check else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
