// Accessibility Test Guide - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "accessibilityCheck": "{ conv.accessibilityCheck if sys.exists('conv', 'accessibilityCheck') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "accessibilityCheck": "{ facts['accessibilityCheck'] if 'accessibilityCheck' in facts and facts['accessibilityCheck'] else accessibilityCheck }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ accessibilityCheck == '' }",
          "then": {
            "ask": {
              "message": "What do you want to check?",
              "inputs": [ { "name": "accessibilityCheck", "type": "str", "description": "For example Screen reader, Keyboard navigation, Color contrast or Captions." } ]
            },
            "var": { "accessibilityCheck": "{ result['accessibilityCheck'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.accessibilityCheck": "{ accessibilityCheck }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records what the user wants to check for accessibility.",
      "args": {
        "accessibilityCheck": { "type": "str", "required": false, "description": "What the user wants to check for accessibility, for example color contrast or keyboard navigation. Empty if unknown." }
      }
    }
  }
}
