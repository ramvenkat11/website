// Job Posting Writer - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "responsibilities": { "question": "{ sys.query }" },
          "qualifications": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "responsibilitiesView": "{ result['responsibilities'] }", "qualificationsView": "{ result['qualifications'] }" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "responsibilities": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gpt5_mini", "prompt": "responsibilities" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "qualifications": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gpt5_mini", "prompt": "qualifications" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
