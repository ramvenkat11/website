// Employee Spotlight Writer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "spotlightNotes": "{ conv.spotlightNotes if sys.exists('conv', 'spotlightNotes') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "spotlightNotes": "{ facts['spotlightNotes'] if 'spotlightNotes' in facts and facts['spotlightNotes'] else spotlightNotes }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ spotlightNotes == '' }",
          "then": {
            "ask": {
              "message": "Tell me about the person being featured.",
              "inputs": [ { "name": "spotlightNotes", "type": "text", "label": "Notes", "description": "Role, team, what they did, a fun fact." } ]
            },
            "var": { "spotlightNotes": "{ result['spotlightNotes'] }" },

            // Stop with an error the user sees.
            "if": {
              "condition": "{ len(spotlightNotes.strip()) == 0 }",
              "then": { "fail": "Please give a few notes about the person." }
            }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.spotlightNotes": "{ spotlightNotes }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the notes about the person being featured.",
      "args": {
        "spotlightNotes": { "type": "str", "required": false, "description": "Notes about the person being featured, such as their role, team, what they did or a fun fact. Empty if unknown." }
      }
    }
  }
}
