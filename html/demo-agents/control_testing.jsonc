// Control Test Results - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "pass_rate", "args": { "tested": 48, "failed": 3 } },

        // Use the value the function returned.
        "var": { "rate": "{ result }" },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "pass_rate": {
      "args": { "tested": { "type": "int" }, "failed": { "type": "int" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round((tested - failed) / tested * 100, 1) }"
      }
    }
  }
}
