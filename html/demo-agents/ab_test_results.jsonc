// A/B Test Result Interpreter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "lift", "args": { "control": 0.042, "variant": 0.047 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "lift": {
      "args": { "control": { "type": "float" }, "variant": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round((variant - control) / control * 100, 1) }"
      }
    }
  }
}
