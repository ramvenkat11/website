// Project Stage-Gate Reviewer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "criteria": ["Technical feasibility", "Market need", "Cost to complete", "Risks and dependencies"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ criteria }",
          "loopVar": "criterion",
          "do": {
            "var": { "lines": "{ lines + '- ' + criterion + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate a mock stage-gate review...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
