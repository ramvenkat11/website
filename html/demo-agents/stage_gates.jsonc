// Project Stage-Gate Reviewer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "criteria": ["Technical feasibility", "Market need", "Cost to complete", "Risks and dependencies"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ criteria }",
          "loopVar": "criterion",
          "do": {
            "var": { "lines": "{ lines + '- ' + criterion + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the project stage-gate reviewer at Northwind Corp. Use made-up project data and say whether the project should pass, hold or stop. Keep the answer short.",
          "user": "{ f'{sys.query} Score each of these:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
