// Parking Permit Requester - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "permitFor": "{ conv.permitFor if sys.exists('conv', 'permitFor') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "permitFor": "{ facts['permitFor'] if 'permitFor' in facts and facts['permitFor'] else permitFor }",
          "isDelivery": "{ facts['isDelivery'] if 'isDelivery' in facts and facts['isDelivery'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ permitFor == '' }",
          "then": {
            "ask": {
              "message": "Who is the permit for?",
              "inputs": [ { "name": "permitFor", "type": "str", "description": "For example Me, A visitor or A delivery." } ]
            },
            "var": { "permitFor": "{ result['permitFor'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "isDelivery": "{ facts['isDelivery'] if 'isDelivery' in facts and facts['isDelivery'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.permitFor": "{ permitFor }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ isDelivery == True }",
          "then": { "end": "Deliveries use the loading dock and need no permit." }
        },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records who the parking permit is for.",
      "args": {
        "permitFor": { "type": "str", "required": false, "description": "Who the parking permit is for, for example the user, a visitor, a contractor or a delivery. Empty if unknown." },
        "isDelivery": { "type": "bool | null", "required": false, "description": "True if the parking permit is for a delivery, false if it is for someone or something else, null when neither the message nor the known facts say." }
      }
    }
  }
}
