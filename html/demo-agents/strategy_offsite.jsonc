// Strategy Offsite Planner - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "sessions": ["Market review", "Three-year goals", "Budget priorities", "Organization changes"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ sessions }",
          "loopVar": "session",
          "do": {
            "var": { "lines": "{ lines + '- ' + session + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the strategy offsite planner at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Plan the agenda around these sessions:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
