// Strategy Offsite Planner - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "sessions": ["Market review", "Three-year goals", "Budget priorities", "Organization changes"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ sessions }",
          "loopVar": "session",
          "do": {
            "var": { "lines": "{ lines + '- ' + session + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate a mock offsite plan...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
