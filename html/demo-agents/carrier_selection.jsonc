// Carrier Selection Advisor - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "shippingMode": "{ conv.shippingMode if sys.exists('conv', 'shippingMode') else '' }",
          "originCountry": "{ conv.originCountry if sys.exists('conv', 'originCountry') else '' }",
          "destinationCountry": "{ conv.destinationCountry if sys.exists('conv', 'destinationCountry') else '' }"
        },
        "var.3": {
          "known": "{ (' Known from this conversation:' + (f' shipping mode {shippingMode}.' if shippingMode else '') + (f' origin country {originCountry}.' if originCountry else '') + (f' destination country {destinationCountry}.' if destinationCountry else '')) if shippingMode or originCountry or destinationCountry else '' }"
        },

        // Run both functions at the same time.
        "parallel": {
          "cost": { "question": "{ sys.query + known }" },
          "reliability": { "question": "{ sys.query + known }" }
        },

        // Copy the result into a variable right away.
        "var.2": { "costView": "{ result['cost'] }", "reliabilityView": "{ result['reliability'] }" },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "cost": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gemini_flash", "prompt": "cost" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "reliability": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gemini_flash", "prompt": "reliability" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
