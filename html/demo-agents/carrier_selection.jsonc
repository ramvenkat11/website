// Carrier Selection Advisor - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "cost": { "question": "{ sys.query }" },
          "reliability": { "question": "{ sys.query }" }
        },

        // Copy the result into a variable right away.
        "var": { "costView": "{ result['cost'] }", "reliabilityView": "{ result['reliability'] }" },

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "cost": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gemini_flash", "prompt": "cost" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "reliability": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gemini_flash", "prompt": "reliability" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
