// Invention Disclosure Helper - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "research lab", "label": "research_lab", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "lab": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which lab are you in?",
              "inputs": [ { "name": "lab", "type": "chooseOne", "options": ["Materials", "Electronics", "Software", "Biotech"] } ]
            },
            "var": { "lab": "{ result['lab'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "research_lab": "{ lab }" } }
          }
        },

        "prompt": {
          "system": "You are the invention disclosure helper at Northwind Corp. Use made-up data. Help the inventor describe the problem, the solution, what is new and who contributed. Keep the answer short.",
          "user": "{ f'{sys.query} The inventor works in the {lab} lab.' }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
