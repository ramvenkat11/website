// Subscription Plan Changer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "planChange": "{ conv.planChange if sys.exists('conv', 'planChange') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "planChange": "{ facts['planChange'] if 'planChange' in facts and facts['planChange'] else planChange }",
          "noChange": "{ facts['noChange'] if 'noChange' in facts and facts['noChange'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ planChange == '' }",
          "then": {
            "ask": {
              "message": "What change?",
              "inputs": [ { "name": "planChange", "type": "str", "description": "For example Upgrade, Downgrade, Pause or Keep my plan." } ]
            },
            "var": { "planChange": "{ result['planChange'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "noChange": "{ facts['noChange'] if 'noChange' in facts and facts['noChange'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.planChange": "{ planChange }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ noChange == True }",
          "then": { "end": "No change made. Your plan stays as it is." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the change the user wants to their subscription plan.",
      "args": {
        "planChange": { "type": "str", "required": false, "description": "What the user wants for their subscription plan, for example an upgrade, a switch to annual billing or keeping the plan as it is. Empty if unknown." },
        "noChange": { "type": "bool | null", "required": false, "description": "True if the user wants to keep the plan unchanged, false if they want a change, null when neither the message nor the known facts say." }
      }
    }
  }
}
