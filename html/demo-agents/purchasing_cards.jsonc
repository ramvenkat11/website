// Purchasing Card Limit Requester - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp", "standardLimit": 5000 },

        // Pause for the user's answer.
        "ask": {
          "message": "What do you need?",
          "inputs": [ { "name": "request", "type": "chooseOne", "options": ["New card", "Higher limit", "Allowed purchases"] } ]
        },

        // Keep the result in a variable.
        "var.2": { "request": "{ result['request'] }" },

        // Branch on a condition.
        "if": {
          "condition": "{ request == 'Higher limit' }",
          "then": { "var": { "focus": "{ 'a monthly limit above the standard ' + str(standardLimit) + ' dollars' }" } },
          "else": { "var": { "focus": "{ request.lower() }" } }
        },

        "prompt": {
          "system": "{ f'You are the purchasing card limit requester at {company}. Use made-up data. Keep the answer short.' }",
          "user": "{ f'{sys.query} The user asks about {focus}.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
