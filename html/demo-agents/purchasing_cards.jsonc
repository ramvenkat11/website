// Purchasing Card Limit Requester - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp", "standardLimit": 5000 },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "cardRequest": "{ conv.cardRequest if sys.exists('conv', 'cardRequest') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "cardRequest": "{ facts['cardRequest'] if 'cardRequest' in facts and facts['cardRequest'] else cardRequest }",
          "higherLimit": "{ facts['higherLimit'] if 'higherLimit' in facts and facts['higherLimit'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ cardRequest == '' }",
          "then": {
            "ask": {
              "message": "What do you need?",
              "inputs": [ { "name": "cardRequest", "type": "str", "description": "For example New card, Higher limit or Allowed purchases." } ]
            },
            "var": { "cardRequest": "{ result['cardRequest'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "higherLimit": "{ facts['higherLimit'] if 'higherLimit' in facts and facts['higherLimit'] is not None else None }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ higherLimit == True }",
          "then": { "var": { "focus": "{ ' The user asks about a monthly limit above the standard ' + str(standardLimit) + ' dollars.' }" } },
          "else": { "var": { "focus": "{ f' The user asks about {cardRequest.lower()}.' if cardRequest else '' }" } }
        },

        // Shared with every agent in the conversation.
        "var.5": { "conv.cardRequest": "{ cardRequest }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records what the user needs for a purchasing card.",
      "args": {
        "cardRequest": { "type": "str", "required": false, "description": "What the user needs for a purchasing card, for example a higher limit or a replacement for a lost card. Empty if unknown." },
        "higherLimit": { "type": "bool | null", "required": false, "description": "True if the user wants a higher card limit, false if they want something else, null when neither the message nor the known facts say." }
      }
    }
  }
}
