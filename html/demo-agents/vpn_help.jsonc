// VPN Connection Troubleshooter - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "device": "{ conv.device if sys.exists('conv', 'device') and conv.device.strip().lower() not in ['all', 'any', 'anything'] else '' }"
        },

        // The list to work through.
        "var.2": { "fixs": ["Check your internet", "Restart the VPN client", "Update the VPN client", "Try another network"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ fixs }",
          "loopVar": "fix",
          "do": {
            "var": { "lines": "{ lines + '- ' + fix + '\\n' }" }
          }
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate mock VPN troubleshooting steps...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
