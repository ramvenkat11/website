// VPN Connection Troubleshooter - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "fixs": ["Check your internet", "Restart the VPN client", "Update the VPN client", "Try another network"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ fixs }",
          "loopVar": "fix",
          "do": {
            "var": { "lines": "{ lines + '- ' + fix + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the vpn connection troubleshooter at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
