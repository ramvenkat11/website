// Warehouse Pick List Generator - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "warehouse": "{ conv.warehouse if sys.exists('conv', 'warehouse') and conv.warehouse.strip().lower() not in ['all', 'any', 'anything'] else '' }"
        },

        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'pick_lists asked: ' + sys.query[:80] }" },

        // Shown only when the agent is validated.
        "trace": "{ 'Question length: ' + str(len(sys.query)) }",

        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
