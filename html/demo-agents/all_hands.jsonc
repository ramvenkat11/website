// All-Hands Question Collector - ollama_nemotron.
{
  "functions": {
    "main": {
      "commands": {
        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'all_hands asked: ' + sys.query[:80] }" },

        // Shown only when the agent is validated.
        "trace": "{ 'Question length: ' + str(len(sys.query)) }",

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Ollama gemma4:31b to generate mock all-hands questions and past answers...",
        "llm": { "profile": "ollama_nemotron", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
