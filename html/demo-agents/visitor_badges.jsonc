// Visitor Badge Registration - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "badge_hours", "args": { "arrive": 9, "leave": 17 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "badge_hours": {
      "args": { "arrive": { "type": "int" }, "leave": { "type": "int" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ leave - arrive }"
      }
    }
  }
}
