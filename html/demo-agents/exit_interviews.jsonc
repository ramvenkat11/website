// Exit Interview Summarizer - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "responses": "{ randint(12, 40) }" },

        // Tell the user what is happening while they wait.
        "progress": "{ f'Found {responses} exit interview responses...' }",

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
