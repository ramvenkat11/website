// Supplier Negotiation Planner - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "target_price", "args": { "quoted": 48000.0, "discount": 0.08 } },

        // Use the value the function returned.
        "var": { "target": "{ result }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate mock data as an agent that prepares a buyer for a price negotiation with a supplier: a target price, a walk-away point, the arguments to use and the concessions to ask for in return...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "target_price": {
      "args": { "quoted": { "type": "float" }, "discount": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(quoted * (1 - discount), 2) }"
      }
    }
  }
}
