// Warranty Claim Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": { "productProblem": "{ conv.productProblem if sys.exists('conv', 'productProblem') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "productProblem": "{ facts['productProblem'] if 'productProblem' in facts and facts['productProblem'] else productProblem }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ productProblem == '' }",
          "then": {
            "ask": {
              "message": "What happened to the product?",
              "inputs": [
                { "name": "productProblem", "type": "str", "description": "For example Any, Stopped working, Broken part or Cosmetic damage." }
              ]
            },
            "var": { "productProblem": "{ result['productProblem'] }" }
          }
        },
        "var.5": { "anyProblem": "{ productProblem.strip().lower() in ['any', 'any problem', 'anything', 'all'] }" },

        // Branch on a condition.
        "if.3": {
          "condition": "{ anyProblem == True }",
          "then": { "var": { "focus": " Focus on any problem." } },
          "else": { "var": { "focus": "{ f' Focus on {productProblem.lower()}.' if productProblem else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.productProblem": "{ productProblem }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the product problem the user is asking about.",
      "args": {
        "productProblem": { "type": "str", "required": false, "description": "What happened to the product, for example a broken part or it stopped working, or Any when the user asks about any kind of problem. Empty if unknown." }
      }
    }
  }
}
