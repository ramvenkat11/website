// Warranty Claim Checker - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // Pause for the user's answer.
        "ask": {
          "message": "What happened to the product?",
          "inputs": [
            { "name": "problem", "type": "chooseOne", "options": ["Any", "Stopped working", "Broken part", "Cosmetic damage"], "default": "Any" }
          ]
        },

        // Keep the result in a variable.
        "var.2": { "problem": "{ result['problem'] }" },

        // Branch on a condition.
        "if": {
          "condition": "{ problem == 'Any' }",
          "then": { "var": { "focus": "any problem" } },
          "else": { "var": { "focus": "{ problem.lower() }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        "prompt": {
          "system": "{ f'You are the warranty claim checker at {company}. Use made-up data. Keep the answer short.' }",
          "user": "{ f'{sys.query} Focus on {focus}.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
