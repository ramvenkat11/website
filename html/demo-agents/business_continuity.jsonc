// Business Continuity Planner - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the disruption.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "scenario": {
                "type": "choice",
                "instructions": "Whether the message names the disruption the user is planning for",
                "criteria": {
                  "stated": "The message names the disruption the user is planning for, for example a site outage or a lost key supplier",
                  "not stated": "The message does not name a disruption"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "scenarioStated": "{ jev['scenario']['choice'] if 'scenario' in jev and 'choice' in jev['scenario'] else 'not stated' }",
          "scenario": ""
        },

        // Ask the user only when the message does not name the disruption.
        "if.2": {
          "condition": "{ scenarioStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which disruption are you planning for?",
              "inputs": [ { "name": "scenario", "type": "str", "description": "For example Site outage, IT system down, Key supplier lost or Pandemic." } ]
            },
            "var": { "scenario": "{ result['scenario'] }" }
          }
        },

        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'continuity plan requested: ' + (scenario if scenario else 'named in the message') }" },

        // The LLM reads the scenario from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the business continuity planner at Northwind Corp. Use made-up data. Give the recovery steps, recovery time targets, backup sites and who to call. Keep the answer short.",
          "user": "{ f'{sys.query} (scenario: {scenario})' if scenario else sys.query }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
