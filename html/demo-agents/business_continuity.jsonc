// Business Continuity Planner - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "disruptionScenario": "{ conv.disruptionScenario if sys.exists('conv', 'disruptionScenario') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "disruptionScenario": "{ facts['disruptionScenario'] if 'disruptionScenario' in facts and facts['disruptionScenario'] else disruptionScenario }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ disruptionScenario == '' }",
          "then": {
            "ask": {
              "message": "Which disruption are you planning for?",
              "inputs": [ { "name": "disruptionScenario", "type": "str", "description": "For example Site outage, IT system down, Key supplier lost or Pandemic." } ]
            },
            "var": { "disruptionScenario": "{ result['disruptionScenario'] }" }
          }
        },

        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'continuity plan requested: ' + (disruptionScenario if disruptionScenario else 'named in the message') }" },

        // Shared with every agent in the conversation.
        "var.4": { "conv.disruptionScenario": "{ disruptionScenario }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the disruption the user is planning for.",
      "args": {
        "disruptionScenario": { "type": "str", "required": false, "description": "The disruption the user is planning for, for example a site outage or a lost key supplier. Empty if unknown." }
      }
    }
  }
}
