// Customs Clearance Assistant - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "originCountry": "{ conv.originCountry if sys.exists('conv', 'originCountry') else '' }",
          "goods": "{ conv.goods if sys.exists('conv', 'goods') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "originCountry": "{ facts['originCountry'] if 'originCountry' in facts and facts['originCountry'] else originCountry }",
          "goods": "{ facts['goods'] if 'goods' in facts and facts['goods'] else goods }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ originCountry == '' }",
          "then": {
            "ask": {
              "message": "Which country are the goods coming from?",
              "inputs": [
                { "name": "originCountry", "type": "str", "description": "For example China, Mexico, Germany or Vietnam." }
              ]
            },
            "var": { "originCountry": "{ result['originCountry'] }" }
          }
        },
        "if.3": {
          "condition": "{ goods == '' }",
          "then": {
            "ask": {
              "message": "What goods are you importing?",
              "inputs": [
                { "name": "goods", "type": "str", "label": "Goods", "description": "For example: steel brackets, cotton shirts" }
              ]
            },
            "var": { "goods": "{ result['goods'] }" },

            // Stop with an error the user sees.
            "if": {
              "condition": "{ goods.strip() == '' }",
              "then": { "fail": "Please describe the goods being imported." }
            }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.originCountry": "{ originCountry }", "conv.goods": "{ goods }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the import shipment the user is asking about.",
      "args": {
        "originCountry": { "type": "str", "required": false, "description": "The country the goods are imported from, for example Vietnam. Empty if unknown." },
        "goods": { "type": "str", "required": false, "description": "The goods being imported, for example cotton shirts. Empty if unknown." }
      }
    }
  }
}
