// Product Launch Messaging Writer - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Kept for this agent across the conversation.
        "var": { "agent.visits": "{ agent.visits + 1 if sys.exists('agent', 'visits') else 1 }" },

        // Shared by every agent in the conversation.
        "var.2": { "conv.lastTopic": "launch messaging" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
