// Executive Travel Planner - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "seatPreference": "{ conv.seatPreference if sys.exists('conv', 'seatPreference') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "seatPreference": "{ facts['seatPreference'] if 'seatPreference' in facts and facts['seatPreference'] else seatPreference }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ seatPreference == '' }",
          "then": {
            "ask": {
              "message": "Which seat does the executive prefer?",
              "inputs": [ { "name": "seatPreference", "type": "str", "description": "For example Aisle, Window or No preference." } ]
            },
            "var": { "seatPreference": "{ result['seatPreference'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.seatPreference": "{ seatPreference }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the seat the executive prefers.",
      "args": {
        "seatPreference": { "type": "str", "required": false, "description": "The seat the executive prefers, for example Aisle or Window, or No preference. Empty if unknown." }
      }
    }
  }
}
