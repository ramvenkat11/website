// Expense Report Checker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "expenseKind": "{ conv.expenseKind if sys.exists('conv', 'expenseKind') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "expenseKind": "{ facts['expenseKind'] if 'expenseKind' in facts and facts['expenseKind'] else expenseKind }",
          "personal": "{ facts['personal'] if 'personal' in facts and facts['personal'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ expenseKind == '' }",
          "then": {
            "ask": {
              "message": "What kind of expense?",
              "inputs": [ { "name": "expenseKind", "type": "str", "description": "For example Travel, Meals, Software or Personal." } ]
            },
            "var": { "expenseKind": "{ result['expenseKind'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "personal": "{ facts['personal'] if 'personal' in facts and facts['personal'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.expenseKind": "{ expenseKind }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ personal == True }",
          "then": { "fail": "Personal expenses cannot be claimed." }
        },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the expense the user is claiming.",
      "args": {
        "expenseKind": { "type": "str", "required": false, "description": "The kind of expense being claimed, for example Meals or Office supplies. Empty if unknown." },
        "personal": { "type": "bool | null", "required": false, "description": "True if the expense is a personal one, False if it is a business one, null when neither the message nor the known facts say." }
      }
    }
  }
}
