// Expense Report Checker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it gives the kind of expense, and whether that is a personal one.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "kind": {
                "type": "choice",
                "instructions": "Whether the message says the kind of expense being claimed",
                "criteria": {
                  "stated": "The message says the kind of expense being claimed, for example meals or office supplies",
                  "not stated": "The message does not say the kind of expense"
                }
              },
              "personal": {
                "type": "choice",
                "instructions": "Whether the expense is a personal one rather than a business one",
                "criteria": {
                  "Yes": "The expense is a personal one",
                  "No": "The expense is a business one",
                  "cannot tell": "The message does not say what the expense is"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "kindStated": "{ jev['kind']['choice'] if 'kind' in jev and 'choice' in jev['kind'] else 'not stated' }",
          "personal": "{ jev['personal']['choice'] if 'personal' in jev and 'choice' in jev['personal'] else 'cannot tell' }",
          "kind": ""
        },

        // Ask the user only when the message does not say the kind of expense.
        "if.2": {
          "condition": "{ kindStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "What kind of expense?",
              "inputs": [ { "name": "kind", "type": "str", "description": "For example Travel, Meals, Software or Personal." } ]
            },
            "var": { "kind": "{ result['kind'] }" }
          }
        },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ personal == 'Yes' }",
          "then": { "fail": "Personal expenses cannot be claimed." }
        },

        // The LLM reads the kind from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the expense report checker at Northwind Corp. Use made-up data. Personal expenses cannot be claimed; say so if the expense is personal. Keep the answer short.",
          "user": "{ f'{sys.query} (kind: {kind})' if kind else sys.query }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
