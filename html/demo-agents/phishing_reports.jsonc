// Phishing Email Reporter - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "phishingClicked": "{ conv.phishingClicked if sys.exists('conv', 'phishingClicked') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "phishingClicked": "{ facts['phishingClicked'] if 'phishingClicked' in facts and facts['phishingClicked'] else phishingClicked }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ phishingClicked == '' }",
          "then": {
            "ask": {
              "message": "Did you click a link in it?",
              "inputs": [ { "name": "phishingClicked", "type": "chooseOne", "options": ["No", "Yes", "Not sure"] } ]
            },
            "var": { "phishingClicked": "{ result['phishingClicked'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.phishingClicked": "{ phishingClicked }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ phishingClicked == 'Yes' }",
          "then": { "fail": "Disconnect from the network now and call the IT security line." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records whether the user clicked a link or opened an attachment in the suspicious email.",
      "args": {
        "phishingClicked": { "type": "str", "required": false, "description": "Whether the user clicked a link or opened an attachment in the email, exactly one of: No (they say they did not), Yes (they say they did), Not sure (they say they are not sure). Empty if not stated." }
      }
    }
  }
}
