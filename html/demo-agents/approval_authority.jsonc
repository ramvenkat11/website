// Approval Authority Lookup - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "approvalDecision": "{ conv.approvalDecision if sys.exists('conv', 'approvalDecision') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "approvalDecision": "{ facts['approvalDecision'] if 'approvalDecision' in facts and facts['approvalDecision'] else approvalDecision }",
          "isContract": "{ facts['isContract'] if 'isContract' in facts and facts['isContract'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ approvalDecision == '' }",
          "then": {
            "ask": {
              "message": "What needs approval?",
              "inputs": [ { "name": "approvalDecision", "type": "str", "description": "For example Spending, Hiring, Contract signing or Pricing change." } ]
            },
            "var": { "approvalDecision": "{ result['approvalDecision'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "isContract": "{ facts['isContract'] if 'isContract' in facts and facts['isContract'] is not None else None }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ isContract == True }",
          "then": { "var": { "note": " Contracts also need a legal review before signing." } },
          "else": {
            "if": {
              "condition": "{ isContract == False }",
              "then": { "var": { "note": " No extra review is needed." } },
              "else": { "var": { "note": "" } }
            }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.approvalDecision": "{ approvalDecision }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the decision the user needs approved.",
      "args": {
        "approvalDecision": { "type": "str", "required": false, "description": "The kind of decision that needs approval, for example hiring or spending. Empty if unknown." },
        "isContract": { "type": "bool | null", "required": false, "description": "True if the decision is signing a contract, False if it is something else, null when neither the message nor the known facts say." }
      }
    }
  }
}
