// Approval Authority Lookup - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the decision, and whether that is a contract.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "decision": {
                "type": "choice",
                "instructions": "Whether the message names the kind of decision that needs approval",
                "criteria": {
                  "stated": "The message names the kind of decision that needs approval, for example hiring or spending",
                  "not stated": "The message does not name the kind of decision"
                }
              },
              "isContract": {
                "type": "choice",
                "instructions": "Whether the decision that needs approval is signing a contract",
                "criteria": {
                  "Yes": "The decision is signing a contract",
                  "No": "The decision is something other than signing a contract",
                  "cannot tell": "The message does not say enough to tell"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "decisionStated": "{ jev['decision']['choice'] if 'decision' in jev and 'choice' in jev['decision'] else 'not stated' }",
          "isContract": "{ jev['isContract']['choice'] if 'isContract' in jev and 'choice' in jev['isContract'] else 'cannot tell' }",
          "decision": ""
        },

        // Ask the user only when the message does not name the decision.
        "if.2": {
          "condition": "{ decisionStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "What needs approval?",
              "inputs": [ { "name": "decision", "type": "str", "description": "For example Spending, Hiring, Contract signing or Pricing change." } ]
            },
            "var": { "decision": "{ result['decision'] }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ isContract == 'Yes' }",
          "then": { "var": { "note": " Contracts also need a legal review before signing." } },
          "else": {
            "if": {
              "condition": "{ isContract == 'No' }",
              "then": { "var": { "note": " No extra review is needed." } },
              "else": { "var": { "note": "" } }
            }
          }
        },

        // The LLM reads the decision from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the approval authority lookup at Northwind Corp. Use made-up data. Contracts also need a legal review before signing. Keep the answer short.",
          "user": "{ sys.query + (f' Decision: {decision}.' if decision else '') + note }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
