// Test Failure Analyzer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Write to the agent server's log.
        "log": { "level": "warning", "message": "{ 'test_failures asked: ' + sys.query[:80] }" },

        // Shown only when the agent is validated.
        "trace": "{ 'Question length: ' + str(len(sys.query)) }",

        "prompt": {
          "system": "You are the test failure analyzer at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
