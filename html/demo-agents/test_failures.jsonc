// Test Failure Analyzer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "productArea": "{ conv.productArea if sys.exists('conv', 'productArea') else '' }"
        },

        // Write to the agent server's log.
        "log": { "level": "warning", "message": "{ 'test_failures asked: ' + sys.query[:80] }" },

        // Shown only when the agent is validated.
        "trace": "{ 'Question length: ' + str(len(sys.query)) }",

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Anthropic claude-haiku-4-5 to generate a mock test failure explanation...",
        "llm": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
