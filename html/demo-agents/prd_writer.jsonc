// Product Requirements Drafter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "sections": ["Problem", "Goals and non-goals", "User stories", "Scope", "Success metrics", "Open questions"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ sections }",
          "loopVar": "section",
          "do": {
            "var": { "lines": "{ lines + '- ' + section + '\\n' }" }
          }
        },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
