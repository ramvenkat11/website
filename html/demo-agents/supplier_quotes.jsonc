// Supplier Quote Comparer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "cheapest": { "question": "{ sys.query }" },
          "fastest": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "cheapestView": "{ result['cheapest'] }", "fastestView": "{ result['fastest'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to combine the 2 results into one answer...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "cheapest": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Google gemini-3.6-flash to name the cheapest supplier (mock data)...",
        "llm": { "profile": "gemini_flash", "prompt": "cheapest" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "fastest": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking Google gemini-3.6-flash to name the fastest supplier (mock data)...",
        "llm": { "profile": "gemini_flash", "prompt": "fastest" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
