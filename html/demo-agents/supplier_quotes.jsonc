// Supplier Quote Comparer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "cheapest": { "question": "{ sys.query }" },
          "fastest": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "output": "{ '## Lowest price\\n' + result['cheapest'] + '\\n\\n## Fastest delivery\\n' + result['fastest'] }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "cheapest": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gemini_flash", "prompt": "cheapest" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "fastest": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gemini_flash", "prompt": "fastest" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
