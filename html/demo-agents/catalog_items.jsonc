// Approved Catalog Item Finder - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "catalog": "{ conv.catalog if sys.exists('conv', 'catalog') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "catalog": "{ facts['catalog'] if 'catalog' in facts and facts['catalog'] else catalog }"
        },
        "var.4": { "catalogScope": "{ 'not stated' if catalog == '' else ('any' if catalog.strip().lower() == 'any' else 'one catalog') }" },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ catalog == '' }",
          "then": {
            "ask": {
              "message": "Which catalog?",
              "inputs": [ { "name": "catalog", "type": "str", "description": "For example Any, IT equipment, Furniture, Lab supplies or Printing." } ]
            },
            "var": {
              "catalog": "{ result['catalog'] }",
              "catalogScope": "{ 'any' if result['catalog'].strip().lower() == 'any' else 'one catalog' }"
            }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ catalogScope == 'any' }",
          "then": { "var": { "focus": " Search every approved catalog." } },
          "else": { "var": { "focus": "{ f' Search the {catalog.lower()} catalog.' if catalog else '' }" } }
        },

        // Shared with every agent in the conversation.
        "var.5": { "conv.catalog": "{ catalog }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records which catalog the user wants to search.",
      "args": {
        "catalog": { "type": "str", "required": false, "description": "The catalog the user wants to search, for example furniture, IT equipment or lab supplies, or 'any' when the user wants every catalog searched. Empty if unknown." }
      }
    }
  }
}
