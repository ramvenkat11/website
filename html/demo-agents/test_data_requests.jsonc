// Test Data Request Desk - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "testData": "{ conv.testData if sys.exists('conv', 'testData') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "testData": "{ facts['testData'] if 'testData' in facts and facts['testData'] else testData }",
          "realCustomerData": "{ facts['realCustomerData'] if 'realCustomerData' in facts and facts['realCustomerData'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ testData == '' }",
          "then": {
            "ask": {
              "message": "What test data do you need?",
              "inputs": [ { "name": "testData", "type": "str", "description": "For example Test accounts, Sample orders or Masked customer data." } ]
            },
            "var": { "testData": "{ result['testData'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "realCustomerData": "{ facts['realCustomerData'] if 'realCustomerData' in facts and facts['realCustomerData'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.testData": "{ testData }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ realCustomerData == True }",
          "then": { "end": "Real customer data cannot be used for testing. Ask for masked customer data instead." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the test data the user is asking for.",
      "args": {
        "testData": { "type": "str", "required": false, "description": "The test data the user needs, for example sample orders or test accounts. Empty if unknown." },
        "realCustomerData": { "type": "bool | null", "required": false, "description": "True if the user wants real, unmasked customer data, false if they want masked or made-up data or anything else, null when neither the message nor the known facts say." }
      }
    }
  }
}
