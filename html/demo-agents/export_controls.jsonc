// Export Control Screener - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the destination country, and whether that is embargoed.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "country": {
                "type": "choice",
                "instructions": "Whether the message names the country the goods are going to",
                "criteria": {
                  "stated": "The message names the country the goods are going to, for example Brazil or Germany",
                  "not stated": "The message does not name a destination country"
                }
              },
              "embargoed": {
                "type": "choice",
                "instructions": "Whether the country the goods are going to is under a trade embargo",
                "criteria": {
                  "Yes": "The destination country is under a trade embargo",
                  "No": "The destination country is not under a trade embargo",
                  "cannot tell": "The message does not name a destination country"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "countryStated": "{ jev['country']['choice'] if 'country' in jev and 'choice' in jev['country'] else 'not stated' }",
          "embargoed": "{ jev['embargoed']['choice'] if 'embargoed' in jev and 'choice' in jev['embargoed'] else 'cannot tell' }",
          "country": ""
        },

        // Ask the user only when the message does not name the destination country.
        "if.2": {
          "condition": "{ countryStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Where is it going?",
              "inputs": [ { "name": "country", "type": "str", "description": "For example Canada, Germany or Japan." } ]
            },
            "var": { "country": "{ result['country'] }" }
          }
        },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ embargoed == 'Yes' }",
          "then": { "fail": "Shipping to embargoed countries is not allowed." }
        },

        // The LLM reads the country from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the export control screener at Northwind Corp. Use made-up data. Shipping to an embargoed country is not allowed; say so if the destination is one. Keep the answer short.",
          "user": "{ f'{sys.query} (country: {country})' if country else sys.query }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
