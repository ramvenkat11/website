// Export Control Screener - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "destinationCountry": "{ conv.destinationCountry if sys.exists('conv', 'destinationCountry') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "destinationCountry": "{ facts['destinationCountry'] if 'destinationCountry' in facts and facts['destinationCountry'] else destinationCountry }",
          "embargoed": "{ facts['embargoed'] if 'embargoed' in facts and facts['embargoed'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ destinationCountry == '' }",
          "then": {
            "ask": {
              "message": "Where is it going?",
              "inputs": [ { "name": "destinationCountry", "type": "str", "description": "For example Canada, Germany or Japan." } ]
            },
            "var": { "destinationCountry": "{ result['destinationCountry'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "embargoed": "{ facts['embargoed'] if 'embargoed' in facts and facts['embargoed'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.destinationCountry": "{ destinationCountry }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ embargoed == True }",
          "then": { "fail": "Shipping to embargoed countries is not allowed." }
        },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records where the goods are going.",
      "args": {
        "destinationCountry": { "type": "str", "required": false, "description": "The country the goods are going to, for example Brazil or Germany. Empty if unknown." },
        "embargoed": { "type": "bool | null", "required": false, "description": "True if the destination country is under a trade embargo, False if it is not, null when neither the message nor the known facts say." }
      }
    }
  }
}
