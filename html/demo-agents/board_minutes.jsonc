// Board Meeting Minutes Drafter - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "decisions": { "question": "{ sys.query }" },
          "actions": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "decisionsView": "{ result['decisions'] }", "actionsView": "{ result['actions'] }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking OpenAI gpt-5-mini to combine the 2 results into one answer...",
        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "decisions": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to list the decisions made (mock data)...",
        "llm": { "profile": "gpt5_mini", "prompt": "decisions" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "actions": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "progress": "Asking OpenAI gpt-5-mini to list the actions assigned (mock data)...",
        "llm": { "profile": "gpt5_mini", "prompt": "actions" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
