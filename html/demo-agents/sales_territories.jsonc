// Sales Territory Lookup - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "home region", "label": "home_region", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "region": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which region are you in?",
              "inputs": [ { "name": "region", "type": "chooseOne", "options": ["North", "South", "East", "West"] } ]
            },
            "var": { "region": "{ result['region'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "home_region": "{ region }" } }
          }
        },

        "prompt": {
          "system": "You are the sales territory lookup at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers region: {region}.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
