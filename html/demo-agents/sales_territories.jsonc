// Sales Territory Lookup - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the sales region.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "region": {
                "type": "choice",
                "instructions": "Whether the message names the sales region the user is in or asks about",
                "criteria": {
                  "stated": "The message names the sales region the user is in or asks about, for example West or North",
                  "not stated": "The message does not name a sales region"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "regionStated": "{ jev['region']['choice'] if 'region' in jev and 'choice' in jev['region'] else 'not stated' }",
          "region": ""
        },

        // Ask the user only when the message does not name the region.
        "if.2": {
          "condition": "{ regionStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which region are you in?",
              "inputs": [ { "name": "region", "type": "str", "description": "For example North, South, East or West." } ]
            },
            "var": { "region": "{ result['region'] }" }
          }
        },

        // The LLM reads the region from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the sales territory lookup at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers region: {region}.' if region else sys.query }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
