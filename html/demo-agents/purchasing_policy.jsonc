// Purchasing Approval Threshold Guide - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "purchaseAmount": "{ conv.purchaseAmount if sys.exists('conv', 'purchaseAmount') else 0 }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "purchaseAmount": "{ float(facts['purchaseAmount']) if 'purchaseAmount' in facts and facts['purchaseAmount'] else purchaseAmount }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ purchaseAmount <= 0 }",
          "then": {
            "ask": {
              "message": "How much will it cost, in US dollars?",
              "inputs": [ { "name": "purchaseAmount", "type": "str", "description": "The total in US dollars, for example 15000 or $15k." } ]
            },
            "var": { "amountText": "{ result['purchaseAmount'].lower().replace('$', '').replace(',', '').strip() }" },
            "if": {
              "condition": "{ not amountText.rstrip('k').replace('.', '', 1).isdigit() }",
              "then": { "fail": "Please give the amount as a number, for example 15000." }
            },
            "var.2": { "purchaseAmount": "{ float(amountText.rstrip('k')) * (1000 if amountText.endswith('k') else 1) }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.purchaseAmount": "{ purchaseAmount }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ purchaseAmount < 1000 }",
          "then": { "end": "Purchases under $1,000 need no approval. Use your purchasing card or the catalog." }
        },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the cost of the purchase.",
      "args": {
        "purchaseAmount": { "type": "float | null", "required": false, "description": "The total cost of the purchase in US dollars, for example 15000 for $15k. Empty if not stated." }
      }
    }
  }
}
