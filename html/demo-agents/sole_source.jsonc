// Sole-Source Justification Writer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says which purchase value band it gives.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "value": {
                "type": "choice",
                "instructions": "The value of the purchase",
                "criteria": {
                  "Under $25k": "The purchase value is under $25,000",
                  "$25k to $100k": "The purchase value is from $25,000 to $100,000, for example $40,000",
                  "$100k to $250k": "The purchase value is from $100,000 to $250,000",
                  "Over $250k": "The purchase value is over $250,000",
                  "not stated": "The message does not give a purchase value"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": { "value": "{ jev['value']['choice'] if 'value' in jev and 'choice' in jev['value'] else 'not stated' }" },

        // Ask the user only when the message does not give the purchase value.
        "if.2": {
          "condition": "{ value == 'not stated' }",
          "then": {
            "ask": {
              "message": "What is the purchase value?",
              "inputs": [ { "name": "value", "type": "chooseOne", "options": ["Under $25k", "$25k to $100k", "$100k to $250k", "Over $250k"] } ]
            },
            "var": { "value": "{ result['value'] }" }
          }
        },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ value == 'Over $250k' }",
          "then": { "fail": "Purchases over $250k cannot be sole-sourced. They must go out to competitive bid." }
        },

        "prompt": {
          "system": "You are the sole-source justification writer at Northwind Corp. Use made-up details. Keep the answer short.",
          "user": "{ f'{sys.query} (purchase value: {value})' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
