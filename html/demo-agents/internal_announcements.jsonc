// Internal Announcement Writer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "announcementAudience": "{ conv.announcementAudience if sys.exists('conv', 'announcementAudience') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "announcementAudience": "{ facts['announcementAudience'] if 'announcementAudience' in facts and facts['announcementAudience'] else announcementAudience }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ announcementAudience == '' }",
          "then": {
            "ask": {
              "message": "Who is the announcement for?",
              "inputs": [ { "name": "announcementAudience", "type": "str", "description": "For example All employees, One department, Managers only or One office." } ]
            },
            "var": { "announcementAudience": "{ result['announcementAudience'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.announcementAudience": "{ announcementAudience }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records who the announcement is for.",
      "args": {
        "announcementAudience": { "type": "str", "required": false, "description": "Who the announcement is for, for example all employees or the London office. Empty if unknown." }
      }
    }
  }
}
