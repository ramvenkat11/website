// Price Quote Generator - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Call a function with arguments.
        "func": { "name": "quote_total", "args": { "seats": 50, "pricePerSeat": 40.0, "discount": 0.1 } },

        // Use the value the function returned.
        "var": { "figure": "{ result }" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Compute a value and return it.
    "quote_total": {
      "args": { "seats": { "type": "int" }, "pricePerSeat": { "type": "float" }, "discount": { "type": "float" } },
      "commands": {
        // Hand the result back to the caller.
        "return": "{ round(seats * pricePerSeat * 12 * (1 - discount), 2) }"
      }
    }
  }
}
