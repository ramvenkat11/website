// Social Media Post Writer - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": { "socialPlatform": "{ conv.socialPlatform if sys.exists('conv', 'socialPlatform') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "socialPlatform": "{ facts['socialPlatform'] if 'socialPlatform' in facts and facts['socialPlatform'] else socialPlatform }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ socialPlatform == '' }",
          "then": {
            "ask": {
              "message": "Which platform?",
              "inputs": [
                { "name": "socialPlatform", "type": "str", "description": "For example All, LinkedIn, X or Instagram." }
              ]
            },
            "var": { "socialPlatform": "{ result['socialPlatform'] }" }
          }
        },
        "var.5": { "allPlatforms": "{ socialPlatform.strip().lower() in ['all', 'all platforms', 'every platform', 'any'] }" },

        // Branch on a condition.
        "if.3": {
          "condition": "{ allPlatforms == True }",
          "then": { "var": { "focus": " Focus on every platform." } },
          "else": { "var": { "focus": "{ f' Focus on {socialPlatform.lower()}.' if socialPlatform else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.socialPlatform": "{ socialPlatform }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the social media post the user wants written.",
      "args": {
        "socialPlatform": { "type": "str", "required": false, "description": "The platform the post is for, for example LinkedIn or Instagram, or All when the user wants every platform. Empty if unknown." }
      }
    }
  }
}
