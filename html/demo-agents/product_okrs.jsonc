// Product OKR Tracker - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "productArea": "{ conv.productArea if sys.exists('conv', 'productArea') else '' }"
        },

        // Work out the current quarter.
        "var.2": { "quarter": "{ 'Q' + str((datetime.now().month - 1) // 3 + 1) + ' ' + str(datetime.now().year) }" },

        // Write to the agent server's log.
        "log": { "level": "info", "message": "{ 'okr tracker asked for ' + quarter }" },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to generate mock product objectives and key results...",
        "llm": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
