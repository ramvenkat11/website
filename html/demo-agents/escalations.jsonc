// Complaint Escalation Router - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Run both functions at the same time.
        "parallel": {
          "summary": { "question": "{ sys.query }" },
          "owner": { "question": "{ sys.query }" }
        },

        // parallel returns a dict keyed by function name.
        "var": { "summaryView": "{ result['summary'] }", "ownerView": "{ result['owner'] }" },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "summary": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gpt5_mini", "prompt": "summary" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    },
    // Takes one argument; parallel runs it alongside the other function.
    "owner": {
      "args": { "question": { "type": "str" } },
      "commands": {
        "llm": { "profile": "gpt5_mini", "prompt": "owner" },
        // Hand the result back to the caller.
        "return": "{ result }"
      }
    }
  }
}
