// Inbound Lead Qualifier - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "companySize": "{ conv.companySize if sys.exists('conv', 'companySize') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "companySize": "{ facts['companySize'] if 'companySize' in facts and facts['companySize'] else companySize }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ companySize == '' }",
          "then": {
            "ask": {
              "message": "How big is the lead's company?",
              "inputs": [
                { "name": "companySize", "type": "chooseOne", "options": ["Any", "Small", "Mid-size", "Enterprise"], "default": "Any" }
              ]
            },
            "var": { "companySize": "{ result['companySize'] }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ companySize == 'Any' }",
          "then": { "var": { "focus": "any company size" } },
          "else": { "var": { "focus": "{ companySize.lower() }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.5": { "conv.companySize": "{ companySize }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records how big the lead's company is.",
      "args": {
        "companySize": { "type": "str", "required": false, "description": "The size of the lead's company, judged from a size word, headcount or revenue: exactly one of Any (the user says size does not matter), Small, Mid-size or Enterprise. Empty if not stated." }
      }
    }
  }
}
