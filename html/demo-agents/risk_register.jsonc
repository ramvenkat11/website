// Risk Register Keeper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "businessUnit": "{ conv.businessUnit if sys.exists('conv', 'businessUnit') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "businessUnit": "{ facts['businessUnit'] if 'businessUnit' in facts and facts['businessUnit'] else businessUnit }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ businessUnit == '' }",
          "then": {
            "ask": {
              "message": "Which business unit's risks do you own?",
              "inputs": [ { "name": "businessUnit", "type": "str", "description": "For example Manufacturing, Retail, Digital or Corporate." } ]
            },
            "var": { "businessUnit": "{ result['businessUnit'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.businessUnit": "{ businessUnit }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the business unit whose risks the user owns.",
      "args": {
        "businessUnit": { "type": "str", "required": false, "description": "The business unit whose risks the user owns, for example retail or manufacturing. Empty if unknown." }
      }
    }
  }
}
