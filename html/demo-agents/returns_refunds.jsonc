// Return and Refund Processor - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "returnReason": "{ conv.returnReason if sys.exists('conv', 'returnReason') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "returnReason": "{ facts['returnReason'] if 'returnReason' in facts and facts['returnReason'] else returnReason }",
          "usedOverAYear": "{ facts['usedOverAYear'] if 'usedOverAYear' in facts and facts['usedOverAYear'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ returnReason == '' }",
          "then": {
            "ask": {
              "message": "Why are you returning it?",
              "inputs": [ { "name": "returnReason", "type": "str", "description": "For example Damaged, Wrong item, Changed my mind or Used for over a year." } ]
            },
            "var": { "returnReason": "{ result['returnReason'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "usedOverAYear": "{ facts['usedOverAYear'] if 'usedOverAYear' in facts and facts['usedOverAYear'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.returnReason": "{ returnReason }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ usedOverAYear == True }",
          "then": { "fail": "Items used for over a year cannot be returned." }
        },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the return the user is asking about.",
      "args": {
        "returnReason": { "type": "str", "required": false, "description": "Why the user is returning the item, for example it is damaged or arrived late. Empty if unknown." },
        "usedOverAYear": { "type": "bool | null", "required": false, "description": "True if the message says the item was used for over a year, false if it says a year or less or not used at all, null when neither the message nor the known facts say." }
      }
    }
  }
}
