// Test Environment Booking - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Ask the user for what the agent needs.
        "ask": {
          "message": "Which test environment?",
          "inputs": [ { "name": "env", "type": "chooseOne", "options": ["QA-1", "QA-2", "Staging", "Production"] } ]
        },

        "var": { "env": "{ result['env'] }" },

        // Stop with an error the user sees.
        "if": {
          "condition": "{ env == 'Production' }",
          "then": { "fail": "Testing is not allowed in production. Book QA-1, QA-2 or Staging." }
        },

        "prompt": {
          "system": "You are the test environment booking assistant at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (environment: {env})' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
