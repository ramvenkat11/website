// Test Environment Booking - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "testEnvironment": "{ conv.testEnvironment if sys.exists('conv', 'testEnvironment') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "testEnvironment": "{ facts['testEnvironment'] if 'testEnvironment' in facts and facts['testEnvironment'] else testEnvironment }",
          "production": "{ facts['production'] if 'production' in facts and facts['production'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ testEnvironment == '' }",
          "then": {
            "ask": {
              "message": "Which test environment?",
              "inputs": [ { "name": "testEnvironment", "type": "str", "description": "For example QA-1, QA-2, Staging or Production." } ]
            },
            "var": { "testEnvironment": "{ result['testEnvironment'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "production": "{ facts['production'] if 'production' in facts and facts['production'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.testEnvironment": "{ testEnvironment }" },

        // Stop with an error the user sees.
        "if.3": {
          "condition": "{ production == True }",
          "then": { "fail": "Testing is not allowed in production. Book QA-1, QA-2 or Staging." }
        },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the test environment the user wants to book.",
      "args": {
        "testEnvironment": { "type": "str", "required": false, "description": "The environment the user wants to book, for example Staging or QA-1. Empty if unknown." },
        "production": { "type": "bool | null", "required": false, "description": "True if the environment the user wants is production, false if it is something else, null when neither the message nor the known facts say." }
      }
    }
  }
}
