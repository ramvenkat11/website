// Deleted File Restore Requester - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Uses an allowlisted function.
        "var": { "versions": "{ randint(3, 30) }" },

        // Tell the user what is happening while they wait.
        "progress": "{ f'Found {versions} backup versions available...' }",

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
