// Performance Review Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "review style", "label": "review_style", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "style": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "How do you like feedback written?",
              "inputs": [ { "name": "style", "type": "chooseOne", "options": ["Brief", "Detailed"] } ]
            },
            "var": { "style": "{ result['style'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "review_style": "{ style }" } }
          }
        },

        "prompt": {
          "system": "You are the performance review helper at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user prefers style: {style}.' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
