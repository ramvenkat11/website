// Performance Review Helper - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "feedbackStyle": "{ conv.feedbackStyle if sys.exists('conv', 'feedbackStyle') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "feedbackStyle": "{ facts['feedbackStyle'] if 'feedbackStyle' in facts and facts['feedbackStyle'] else feedbackStyle }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ feedbackStyle == '' }",
          "then": {
            "ask": {
              "message": "How do you like feedback written?",
              "inputs": [ { "name": "feedbackStyle", "type": "str", "description": "For example Brief or Detailed." } ]
            },
            "var": { "feedbackStyle": "{ result['feedbackStyle'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.feedbackStyle": "{ feedbackStyle }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records how the user wants review feedback written.",
      "args": {
        "feedbackStyle": { "type": "str", "required": false, "description": "How the user wants the review feedback written, for example brief or detailed with examples. Empty if unknown." }
      }
    }
  }
}
