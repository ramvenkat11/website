// Press Release Drafter - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "announcement": "{ conv.announcement if sys.exists('conv', 'announcement') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "announcement": "{ facts['announcement'] if 'announcement' in facts and facts['announcement'] else announcement }",
          "notDecided": "{ facts['notDecided'] if 'notDecided' in facts and facts['notDecided'] is not None else None }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ announcement == '' }",
          "then": {
            "ask": {
              "message": "What is being announced?",
              "inputs": [ { "name": "announcement", "type": "str", "description": "For example Product launch, Partnership, New hire or Not decided." } ]
            },
            "var": { "announcement": "{ result['announcement'] }" },

            // Check the typed answer as well.
            "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
            "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },
            "var.3": { "notDecided": "{ facts['notDecided'] if 'notDecided' in facts and facts['notDecided'] is not None else None }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.announcement": "{ announcement }" },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ notDecided == True }",
          "then": { "end": "Come back once the announcement is decided." }
        },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records what the press release announces.",
      "args": {
        "announcement": { "type": "str", "required": false, "description": "What the press release announces, for example a product launch or quarterly results, or not decided. Empty if unknown." },
        "notDecided": { "type": "bool | null", "required": false, "description": "True if what to announce is not decided yet, false if it is decided, null when neither the message nor the known facts say." }
      }
    }
  }
}
