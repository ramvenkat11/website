// Press Release Drafter - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it says what is being announced, and whether that is not decided yet.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "announcement": {
                "type": "choice",
                "instructions": "Whether the message says what the press release announces",
                "criteria": {
                  "stated": "The message says what the press release announces, for example a product launch or quarterly results, or says that it is not decided yet",
                  "not stated": "The message does not say what is being announced"
                }
              },
              "notDecided": {
                "type": "choice",
                "instructions": "Whether what to announce is not decided yet",
                "criteria": {
                  "Yes": "The message says what to announce is not decided yet",
                  "No": "The message says what is being announced",
                  "cannot tell": "The message does not say enough to tell"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "announcementStated": "{ jev['announcement']['choice'] if 'announcement' in jev and 'choice' in jev['announcement'] else 'not stated' }",
          "notDecided": "{ jev['notDecided']['choice'] if 'notDecided' in jev and 'choice' in jev['notDecided'] else 'cannot tell' }",
          "announcement": ""
        },

        // Ask the user only when the message does not say what is being announced.
        "if.2": {
          "condition": "{ announcementStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "What is being announced?",
              "inputs": [ { "name": "announcement", "type": "str", "description": "For example Product launch, Partnership, New hire or Not decided." } ]
            },
            "var": { "announcement": "{ result['announcement'] }" }
          }
        },

        // Finish early with a message; no LLM call needed.
        "if.3": {
          "condition": "{ notDecided == 'Yes' }",
          "then": { "end": "Come back once the announcement is decided." }
        },

        // The LLM reads the announcement from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the press release drafter at Northwind Corp. Use made-up data. If what is being announced is not decided yet, tell the user to come back once it is decided. Keep the answer short.",
          "user": "{ f'{sys.query} (announcement: {announcement})' if announcement else sys.query }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
