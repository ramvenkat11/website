// Bug Triage Assistant - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "bugSeverity": "{ conv.bugSeverity if sys.exists('conv', 'bugSeverity') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "bugSeverity": "{ facts['bugSeverity'] if 'bugSeverity' in facts and facts['bugSeverity'] else bugSeverity }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ bugSeverity == '' }",
          "then": {
            "ask": {
              "message": "How bad is the bug?",
              "inputs": [ { "name": "bugSeverity", "type": "chooseOne", "options": ["Crash or data loss", "Feature broken", "Cosmetic", "Not sure"] } ]
            },
            "var": { "bugSeverity": "{ result['bugSeverity'] }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ bugSeverity == 'Crash or data loss' }",
          "then": { "var": { "priority": "P1 - fix before anything else" } },
          "else": { "var": { "priority": "to be decided by the triage meeting" } }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.bugSeverity": "{ bugSeverity }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records how bad the reported bug is.",
      "args": {
        "bugSeverity": { "type": "str", "required": false, "description": "How bad the bug is, exactly one of: Crash or data loss (the app crashes or loses data), Feature broken (a feature does not work), Cosmetic (only how something looks), Not sure (the user says they do not know). Empty if not stated." }
      }
    }
  }
}
