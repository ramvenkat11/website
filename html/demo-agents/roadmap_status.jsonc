// Roadmap Status Lookup - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Look up what this user told the agent before.
        "memory": { "query": "product area", "label": "product_area", "limit": 1 },

        "if": {
          "condition": "{ len(result) > 0 }",
          "then": {
            "var": { "productArea": "{ result[0]['text'] }" }
          },
          "else": {
            // Ask only the first time.
            "ask": {
              "message": "Which product area do you follow?",
              "inputs": [ { "name": "productArea", "type": "chooseOne", "options": ["Mobile app", "Web app", "Integrations", "Billing"] } ]
            },
            "var": { "productArea": "{ result['productArea'] }" },
            // Remember the answer for next time.
            "memory": { "store": { "product_area": "{ productArea }" } }
          }
        },

        "prompt": {
          "system": "You are the roadmap status lookup at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user follows product area: {productArea}.' }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
