// Roadmap Status Lookup - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it names the product area.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "productArea": {
                "type": "choice",
                "instructions": "Whether the message names the product area the user follows or asks about",
                "criteria": {
                  "stated": "The message names the product area the user follows or asks about, for example billing or the mobile app",
                  "not stated": "The message does not name a product area"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "productAreaStated": "{ jev['productArea']['choice'] if 'productArea' in jev and 'choice' in jev['productArea'] else 'not stated' }",
          "productArea": ""
        },

        // Ask the user only when the message does not name the product area.
        "if.2": {
          "condition": "{ productAreaStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "Which product area do you follow?",
              "inputs": [ { "name": "productArea", "type": "str", "description": "For example Mobile app, Web app, Integrations or Billing." } ]
            },
            "var": { "productArea": "{ result['productArea'] }" }
          }
        },

        // The LLM reads the product area from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the roadmap status lookup at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} The user follows product area: {productArea}.' if productArea else sys.query }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
