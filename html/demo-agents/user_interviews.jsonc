// User Interview Guide Builder - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // Jev reads the message and says whether it says what the user wants to learn.
        "api": {
          "profile": "jev",
          "body": {
            "model": "jev-latest",
            "state": "{ sys.query }",
            "questions": {
              "goal": {
                "type": "choice",
                "instructions": "Whether the message says what the user wants to learn from the interviews",
                "criteria": {
                  "stated": "The message says what the user wants to learn from the interviews, for example to understand churn or test a concept",
                  "not stated": "The message does not say what the user wants to learn"
                }
              }
            }
          }
        },
        "var": { "jev": "{ result['answers'] if isinstance(result, dict) and 'answers' in result else {} }", "jevReply": "{ str(result)[:300] }" },

        // A Jev failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(jev) == 0 }",
          "then": { "log": { "level": "error", "message": "{ 'Jev returned no answers: ' + jevReply }" } }
        },
        "var.2": {
          "goalStated": "{ jev['goal']['choice'] if 'goal' in jev and 'choice' in jev['goal'] else 'not stated' }",
          "goal": ""
        },

        // Ask the user only when the message does not say what the user wants to learn.
        "if.2": {
          "condition": "{ goalStated == 'not stated' }",
          "then": {
            "ask": {
              "message": "What do you want to learn?",
              "inputs": [ { "name": "goal", "type": "str", "description": "For example Discover problems, Test a concept or Understand churn." } ]
            },
            "var": { "goal": "{ result['goal'] }" }
          }
        },

        // The LLM reads the goal from the message; the asked one is added only when there was an ask.
        "prompt": {
          "system": "You are the user interview guide builder at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} (research goal: {goal})' if goal else sys.query }"
        },
        "llm": { "profile": "gemini_flash", "streamOutput": true }
      }
    }
  }
}
