// User Interview Guide Builder - gemini_flash.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "interviewGoal": "{ conv.interviewGoal if sys.exists('conv', 'interviewGoal') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "interviewGoal": "{ facts['interviewGoal'] if 'interviewGoal' in facts and facts['interviewGoal'] else interviewGoal }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ interviewGoal == '' }",
          "then": {
            "ask": {
              "message": "What do you want to learn?",
              "inputs": [ { "name": "interviewGoal", "type": "str", "description": "For example Discover problems, Test a concept or Understand churn." } ]
            },
            "var": { "interviewGoal": "{ result['interviewGoal'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.interviewGoal": "{ interviewGoal }" },

        "llm.2": { "profile": "gemini_flash", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records what the user wants to learn from the interviews.",
      "args": {
        "interviewGoal": { "type": "str", "required": false, "description": "What the user wants to learn from the interviews, for example to understand churn or test a concept. Empty if unknown." }
      }
    }
  }
}
