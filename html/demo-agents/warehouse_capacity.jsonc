// Warehouse Capacity Planner - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "sites": ["Dallas", "Columbus", "Reno", "Savannah"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ sites }",
          "loopVar": "site",
          "do": {
            "var": { "lines": "{ lines + '- ' + site + ' warehouse\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the warehouse capacity planner at Northwind Corp. Use made-up data. Show pallet positions used and free, and forecast when each site fills up. Keep the answer short.",
          "user": "{ f'{sys.query} Cover each of these:\\n{lines}' }"
        },
        "llm": { "profile": "gpt5_mini", "streamOutput": true }
      }
    }
  }
}
