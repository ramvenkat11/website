// Warehouse Capacity Planner - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "warehouse": "{ conv.warehouse if sys.exists('conv', 'warehouse') and conv.warehouse.strip().lower() not in ['all', 'any', 'anything'] else '' }"
        },

        // The list to work through.
        "var.2": { "sites": ["Dallas", "Columbus", "Reno", "Savannah"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ sites }",
          "loopVar": "site",
          "do": {
            "var": { "lines": "{ lines + '- ' + site + ' warehouse\\n' }" }
          }
        },

        "llm": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    }
  }
}
