// Data Quality Issue Reporter - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // The list to work through.
        "var": { "checks": ["Missing rows", "Duplicate records", "Late loads", "Wrong values", "Schema changes"], "lines": "" },

        // Go through each item in turn.
        "for": {
          "iter": "{ checks }",
          "loopVar": "check",
          "do": {
            "var": { "lines": "{ lines + '- ' + check + '\\n' }" }
          }
        },

        "prompt": {
          "system": "You are the data quality issue reporter at Northwind Corp. Use made-up data. Keep the answer short.",
          "user": "{ f'{sys.query} Consider each of these:\\n{lines}' }"
        },
        "llm": { "profile": "claude_haiku", "streamOutput": true }
      }
    }
  }
}
