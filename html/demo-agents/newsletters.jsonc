// Email Newsletter Writer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": {
          "tone": "{ conv.tone if sys.exists('conv', 'tone') else '' }"
        },

        // Tell the user what is happening before each wait for an LLM.
        "progress": "Asking Google gemini-3.6-flash to find the newsletter tone in your message...",

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "tone": "{ facts['tone'] if 'tone' in facts and facts['tone'] else tone }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ tone == '' }",
          "then": {
            "ask": {
              "message": "What tone should the newsletter use?",
              "inputs": [ { "name": "tone", "type": "str", "description": "For example Friendly, Formal or Playful." } ]
            },
            "var": { "tone": "{ result['tone'] }" }
          }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.tone": "{ tone }" },

        "progress.2": "Asking Anthropic claude-haiku-4-5 to generate a mock newsletter...",
        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the tone the user wants for the newsletter.",
      "args": {
        "tone": { "type": "str", "required": false, "description": "The tone the newsletter should be written in, for example friendly or upbeat. Empty if unknown." }
      }
    }
  }
}
