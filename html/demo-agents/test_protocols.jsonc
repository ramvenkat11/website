// Test Protocol Writer - claude_haiku.
{
  "functions": {
    "main": {
      "commands": {
        // What this or another agent already learned in this conversation.
        "var": { "productStage": "{ conv.productStage if sys.exists('conv', 'productStage') else '' }" },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.2": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.3": {
          "productStage": "{ facts['productStage'] if 'productStage' in facts and facts['productStage'] else productStage }"
        },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ productStage == '' }",
          "then": {
            "ask": {
              "message": "What are you testing?",
              "inputs": [ { "name": "productStage", "type": "chooseOne", "options": ["Early prototype", "Pre-production unit", "Final design"], "default": "Early prototype" } ]
            },
            "var": { "productStage": "{ result['productStage'] }" }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ productStage == 'Final design' }",
          "then": { "var": { "depth": "full qualification with pass and fail limits" } },
          "else": { "var": { "depth": "a short exploratory test plan" } }
        },

        // Shared with every agent in the conversation.
        "var.4": { "conv.productStage": "{ productStage }" },

        "llm.2": { "profile": "claude_haiku", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records the stage of the product the user is testing.",
      "args": {
        "productStage": { "type": "str", "required": false, "description": "The stage of the product being tested, exactly one of: Early prototype (an early prototype or a proof of concept), Pre-production unit, Final design. Empty if not stated." }
      }
    }
  }
}
