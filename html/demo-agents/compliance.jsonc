// Regulatory Compliance Answerer - gpt5_mini.
{
  "functions": {
    "main": {
      "commands": {
        // Values used below.
        "var": { "company": "Northwind Corp" },

        // What this or another agent already learned in this conversation.
        "var.2": {
          "regulationArea": "{ conv.regulationArea if sys.exists('conv', 'regulationArea') else '' }"
        },

        // The message wins over what was known; a field neither has comes back empty.
        "llm": { "profile": "gemini_flash", "prompt": "extract", "outputFormat": "structured", "functions": ["facts"] },
        "var.3": { "facts": "{ result['facts'] if isinstance(result, dict) and 'facts' in result and isinstance(result['facts'], dict) else {} }" },

        // An extraction failure must show in the log; the agent then asks instead of guessing.
        "if": {
          "condition": "{ len(facts) == 0 }",
          "then": { "log": { "level": "error", "message": "Extraction returned no facts" } }
        },
        "var.4": {
          "regulationArea": "{ facts['regulationArea'] if 'regulationArea' in facts and facts['regulationArea'] else regulationArea }"
        },
        "var.5": { "regulationAreaScope": "{ 'not stated' if regulationArea == '' else ('any' if regulationArea.strip().lower() == 'any' else 'one rule') }" },

        // Ask only for what neither the message nor the conversation has.
        "if.2": {
          "condition": "{ regulationArea == '' }",
          "then": {
            "ask": {
              "message": "Which rule?",
              "inputs": [
              { "name": "regulationArea", "type": "str", "description": "For example Any, Anti-bribery, Data protection or Competition." }
            ]
            },
            "var": {
              "regulationArea": "{ result['regulationArea'] }",
              "regulationAreaScope": "{ 'any' if result['regulationArea'].strip().lower() == 'any' else 'one rule' }"
            }
          }
        },

        // Branch on a condition.
        "if.3": {
          "condition": "{ regulationAreaScope == 'any' }",
          "then": { "var": { "focus": " Focus on any rule." } },
          "else": { "var": { "focus": "{ f' Focus on {regulationArea.lower()}.' if regulationArea else '' }" } }
        },

        // Tell the user what is happening while they wait.
        "progress": "Working on it...",

        // Shared with every agent in the conversation.
        "var.6": { "conv.regulationArea": "{ regulationArea }" },

        "llm.2": { "profile": "gpt5_mini", "prompt": "default", "streamOutput": true }
      }
    },
    // The shape of the extraction; never run.
    "facts": {
      "description": "Records which area of regulation the user asks about.",
      "args": {
        "regulationArea": { "type": "str", "required": false, "description": "The area of regulation the user asks about, for example data protection, anti-bribery or competition, or 'any' when the user says any rule. Empty if unknown." }
      }
    }
  }
}
